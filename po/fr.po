msgstr "Exemple de message"

msgctxt "page.aiWatch.title"
msgid "New AI crawlers appear often"
msgstr "De nouveaux robots d'IA apparaissent souvent"

msgctxt "page.aiWatch.body"
msgid "When a new AI crawler shows up, we add it to the list and check your file again."
msgstr "Quand un nouveau robot d'IA apparaît, nous l'ajoutons à la liste et revérifions votre fichier."

msgctxt "page.aiWatch.agents"
msgid "AI agents checked"
msgstr "Agents d'IA vérifiés"

msgctxt "page.aiWatch.rate"
