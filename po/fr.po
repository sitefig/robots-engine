msgstr "Recevez un message quand un robots.txt change"

msgctxt "page.promo.body"
msgid "Monitoring checks your sites and your competitors' sites every six hours. When a file changes, you get a message in Slack, Discord or Teams with the lines that changed and the crawlers it affects."
msgstr "La surveillance vérifie vos sites et ceux de vos concurrents toutes les six heures. Quand un fichier change, vous recevez un message dans Slack, Discord ou Teams avec les lignes modifiées et les robots concernés."

msgctxt "page.promo.cta"
msgid "See monitoring plans"
msgstr "Voir les offres de surveillance"

msgctxt "page.promo.sample"
msgid "Browse the change history of {tracked} large sites"
msgstr "Parcourir l'historique de {tracked} grands sites"

msgctxt "page.promo.diffLabel"
