msgstr "SEO-lõks"

msgctxt "enum.kind.sitemap"
msgid "Sitemap"
msgstr "Saidikaart"

msgctxt "enum.kind.fetch"
msgid "Fetch"
msgstr "Laadimine"

msgctxt "enum.kind.lint"
