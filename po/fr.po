msgctxt "ui.summary.redirectLimit.title"
msgid "Too many redirects"
msgstr "Trop de redirections"

msgctxt "ui.summary.redirectLimit.body"
msgid "The file was not reached within five redirects. Google treats this as a missing robots.txt: no restrictions. Fix the redirect chain."
msgstr "Le fichier n'a pas été atteint en cinq redirections. Google traite cela comme un robots.txt absent : aucune restriction. Corrigez la chaîne de redirections."

msgctxt "ui.summary.notFound.title"
msgid "No robots.txt found"
msgstr "Aucun robots.txt trouvé"

msgctxt "ui.summary.notFound.body"
msgid "The server answered HTTP {status}. Crawlers treat a missing robots.txt as \"everything allowed\"."
msgstr "Le serveur a répondu HTTP {status}. Les robots traitent un robots.txt absent comme « tout autorisé »."

msgctxt "ui.summary.clientError.body"
msgid "Google treats any 4xx response as \"no restrictions\". Most other crawlers do the same."
msgstr "Google traite toute réponse 4xx comme « aucune restriction ». La plupart des autres robots font de même."

msgctxt "ui.summary.serverError.title"
msgid "Server error, HTTP {status}"
msgstr "Erreur serveur, HTTP {status}"

msgctxt "ui.summary.serverError.body"
msgid "Google treats 5xx responses as a temporary \"disallow everything\" for up to 30 days, then as no restrictions. Other crawlers vary."
msgstr "Google traite les réponses 5xx comme un « tout interdire » temporaire pendant jusqu'à 30 jours, puis comme aucune restriction. Les autres robots varient."

msgctxt "ui.summary.unexpectedStatus.title"
msgid "Unexpected HTTP {status}"
msgstr "HTTP {status} inattendu"

msgctxt "ui.summary.unexpectedStatus.body"
msgid "The body was ignored because the response was not a success."
msgstr "Le contenu a été ignoré parce que la réponse n'était pas un succès."

msgctxt "ui.summary.html.title"
msgid "The server returned HTML"
msgstr "Le serveur a renvoyé du HTML"

msgctxt "ui.summary.html.body"
msgid "Content type is \"{type}\". This is probably a soft-404 page rather than a robots.txt. Crawlers may still try to parse it and usually find no rules."
msgstr "Le type de contenu est « {type} ». C'est probablement une page soft-404 plutôt qu'un robots.txt. Les robots peuvent quand même tenter de l'analyser et ne trouvent généralement aucune règle."

msgctxt "ui.summary.empty.title"
msgid "Empty robots.txt"
msgstr "robots.txt vide"

msgctxt "ui.summary.empty.body"
msgid "No rules. Every crawler may access everything."
msgstr "Aucune règle. Tous les robots peuvent tout explorer."

msgctxt "ui.summary.noStar.title"
msgid "No \"*\" group"
msgstr "Pas de groupe « * »"

msgctxt "ui.summary.noStar.body"
msgid "Crawlers without a group of their own may access everything."
msgstr "Les robots sans groupe propre peuvent tout explorer."

msgctxt "ui.summary.allBlocked.title"
msgid "Everything blocked by default"
msgstr "Tout est bloqué par défaut"

msgctxt "ui.summary.allBlocked.body"
msgid "The \"*\" group disallows the whole site. Only crawlers with their own group can get in."
msgstr "Le groupe « * » interdit tout le site. Seuls les robots avec leur propre groupe peuvent entrer."

msgctxt "ui.summary.open.title"
msgid "No restrictions by default"
msgstr "Aucune restriction par défaut"

msgctxt "ui.summary.open.body"
msgid "The \"*\" group has no Disallow rules that apply."
msgstr "Le groupe « * » n'a aucune règle Disallow applicable."

msgctxt "ui.summary.restricted.title"
msgid "Restricted by default"
msgstr "Restreint par défaut"

msgctxt "ui.summary.restricted.body"
msgid "The \"*\" group has {disallow} Disallow and {allow} Allow rules. Test paths below to see what they cover."
msgstr "Le groupe « * » a {disallow} règles Disallow et {allow} règles Allow. Testez des chemins ci-dessous pour voir ce qu'elles couvrent."

