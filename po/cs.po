msgstr "Vyhledávací index ChatGPT. Nepoužívá se k trénování."

msgctxt "agents.note.chatgptUser"
msgid "Fetches pages on a user's request inside ChatGPT."
msgstr "Stahuje stránky na žádost uživatele v ChatGPT."

msgctxt "agents.note.claudeSearchbot"
msgid "Anthropic search index. Not used for training."
msgstr "Vyhledávací index Anthropic. Nepoužívá se k trénování."

msgctxt "agents.note.claudeUser"
msgid "Fetches pages on a user's request inside Claude."
msgstr "Stahuje stránky na žádost uživatele v Claude."

msgctxt "agents.note.perplexitybot"
msgid "Perplexity search index."
msgstr "Vyhledávací index Perplexity."

msgctxt "agents.note.perplexityUser"
msgid "Fetches pages on a user's request inside Perplexity."
msgstr "Stahuje stránky na žádost uživatele v Perplexity."

msgctxt "agents.note.duckassistbot"
msgid "DuckDuckGo AI answers."
msgstr "AI odpovědi DuckDuckGo."

msgctxt "agents.note.youbot"
msgid "You.com search."
msgstr "Vyhledávání You.com."

msgctxt "ai.noGroup"
msgid "No matching group, so everything is allowed."
msgstr "Žádná odpovídající skupina, takže je povoleno vše."

msgctxt "ai.ownGroup"
msgid "Has its own \"{token}\" group."
msgstr "Má vlastní skupinu „{token}“."

msgctxt "ai.starGroup"
msgid "Falls back to the \"*\" group."
msgstr "Použije skupinu „*“."

msgctxt "ai.headline"
msgid "{label}: {blocked} of {total} blocked"
msgstr "{label}: blokováno {blocked} z {total}"

msgctxt "ai.callout.none"
msgid "No AI training crawlers are configured."
msgstr "Nejsou nastaveny žádné AI crawlery pro trénování."

msgctxt "ai.callout.allBlocked"
msgid "Every known AI training crawler is blocked."
msgstr "Všechny známé AI crawlery pro trénování jsou blokovány."

msgctxt "ai.callout.noneRestricted"
msgid "No AI training crawler is restricted. Content on this site may be used for model training."
msgstr "Žádný AI crawler pro trénování není omezen. Obsah webu může být použit k trénování modelů."

msgctxt "ai.callout.noneNamed"
msgid "No AI training crawler is addressed by name; all of them follow the default \"*\" rules. Content may be used for model training."
msgstr "Žádný AI crawler pro trénování není uveden jménem; všechny se řídí výchozími pravidly „*“. Obsah může být použit k trénování modelů."

msgctxt "ai.callout.uneven"
msgid "AI training crawlers are treated unevenly. Still allowed or only partly restricted: {list}."
msgstr "AI crawlery pro trénování jsou omezeny nejednotně. Stále povolené nebo jen částečně omezené: {list}."

