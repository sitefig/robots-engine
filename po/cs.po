msgctxt "ui.handoff.copiedAll"
msgid "Copied all {n} fixes"
msgstr "Zkopírovány všechny opravy ({n})"

msgctxt "ui.handoff.jira"
msgid "Export for Jira"
msgstr "Export pro Jiru"

msgctxt "ui.handoff.watch"
msgid "Want to know when the fix is live? We check the file every day and email you when it changes. Free, no card. Want to watch competitors too? See below."
msgstr "Chcete vědět, kdy bude oprava nasazená? Soubor kontrolujeme každý den a pošleme vám e-mail, když se změní. Zdarma, bez karty. Chcete sledovat i konkurenci? Podívejte se níže."

msgctxt "ui.handoff.watchCta"
msgid "Watch for free"
msgstr "Sledovat zdarma"

msgctxt "ui.compare.eyebrow"
msgid "Next: how do you compare?"
msgstr "Dále: jak si stojíte ve srovnání?"

msgctxt "ui.compare.title"
msgid "See what your competitor lets search engines and AI read"
msgstr "Podívejte se, co váš konkurent dovoluje číst vyhledávačům a AI"

msgctxt "ui.compare.body"
msgid "Every robots.txt is public. Compare yours with any competitor once, for free. If a competitor opens up to AI search or hides a category, that is a signal worth knowing about."
msgstr "Každý robots.txt je veřejný. Porovnejte svůj s libovolným konkurentem, jednou a zdarma. Když se konkurent otevře AI vyhledávání nebo skryje některou kategorii, je to signál, o kterém se vyplatí vědět."

msgctxt "ui.compare.label"
msgid "A competitor's domain"
msgstr "Doména konkurenta"

msgctxt "ui.compare.run"
msgid "Compare free"
msgstr "Porovnat zdarma"

msgctxt "ui.compare.running"
msgid "Fetching the other file."
msgstr "Stahujeme druhý soubor."

msgctxt "ui.compare.youAre"
msgid "{host} vs"
msgstr "{host} vs."

msgctxt "ui.compare.th.what"
msgid "What it means"
msgstr "Co to znamená"

msgctxt "ui.compare.th.so"
msgid "So what"
msgstr "Co z toho plyne"

msgctxt "ui.compare.row.found"
msgid "Found by Bing, DuckDuckGo and Apple"
msgstr "Web najdou Bing, DuckDuckGo a Apple"

msgctxt "ui.compare.row.cited"
msgid "Cited by AI search"
msgstr "Citace v AI vyhledávání"

msgctxt "ui.compare.row.training"
msgid "Content used for AI training"
msgstr "Obsah použit k trénování AI"

msgctxt "ui.compare.row.exposed"
msgid "Sensitive locations exposed"
msgstr "Odhalená citlivá místa"

msgctxt "ui.compare.row.changed"
msgid "Last change to the file"
msgstr "Poslední změna souboru"

msgctxt "ui.compare.so.found"
msgid "They get search traffic you are missing."
msgstr "Získávají návštěvnost z vyhledávání, která vám chybí."

msgctxt "ui.compare.so.cited"
msgid "AI answers will recommend them, not you."
msgstr "AI odpovědi budou doporučovat je, ne vás."

msgctxt "ui.compare.so.training"
msgid "They chose what happens to their content."
msgstr "Sami rozhodli, co se s jejich obsahem stane."

msgctxt "ui.compare.so.exposed"
msgid "Your file gives an attacker more to go on."
msgstr "Váš soubor dává útočníkovi víc vodítek."

msgctxt "ui.compare.so.changed"
msgid "Only watching can tell you when theirs changes."
msgstr "Kdy se změní ten jejich, vám řekne jen sledování."

msgctxt "ui.compare.yes"
msgid "Yes"
msgstr "Ano"

msgctxt "ui.compare.no"
msgid "No"
msgstr "Ne"

msgctxt "ui.compare.partly"
msgid "Partly"
msgstr "Částečně"

msgctxt "ui.compare.unknown"
msgid "Unknown"
msgstr "Neznámé"

msgctxt "ui.compare.ofTotal"
msgid "{n} of {total}"
msgstr "{n} z {total}"

msgctxt "ui.compare.upsell.title"
msgid "This is today's snapshot. They will change it next week."
msgstr "Tohle je dnešní stav. Příští týden ho změní."

msgctxt "ui.compare.upsell.body"
msgid "Watching keeps your own domains and your competitors under check, and tells you in plain language when one of them blocks or opens up to a crawler, hides a section or puts new pages out."
msgstr "Sledování hlídá vaše vlastní domény i konkurenci a srozumitelně vám řekne, když některá z nich zablokuje nebo pustí dovnitř robota, skryje sekci nebo zveřejní nové stránky."

msgctxt "ui.compare.cta"
msgid "Watch both"
msgstr "Sledovat obě domény"

msgctxt "ui.appendix.body"
msgid "For whoever edits the file. Everything the report used to open with is still here, folded away."
msgstr "Pro toho, kdo soubor upravuje. Vše, čím zpráva dřív začínala, je pořád tady, jen sbalené."

msgctxt "ui.appendix.issues"
msgid "Every finding with its line"
msgstr "Každý nález se svým řádkem"

msgctxt "ui.appendix.agents"
msgid "Rules resolved per crawler with RFC 9309 matching"
msgstr "Pravidla vyhodnocená pro každého robota podle RFC 9309"

msgctxt "ui.appendix.ai"
msgid "Training and search agents, blocked or allowed"
msgstr "Agenti pro trénování a vyhledávání, blokovaní nebo povolení"

msgctxt "ui.appendix.security"
msgid "Every sensitive path the file names"
msgstr "Každá citlivá cesta, kterou soubor jmenuje"

msgctxt "ui.appendix.recon"
msgid "Platform, cloud buckets, other hosts, interfaces, comments and sitemaps"
msgstr "Platforma, cloudové buckety, jiné hostname, rozhraní, komentáře a sitemapy"

msgctxt "ui.appendix.tester"
msgid "Check any path against any crawler"
msgstr "Ověřte libovolnou cestu pro libovolného robota"

msgctxt "ui.appendix.access"
msgid "Fetch the file again as each crawler"
msgstr "Stáhněte soubor znovu jménem každého robota"

msgctxt "ui.appendix.footnote"
msgid "The analysis runs in your browser. Rule matching follows RFC 9309 and Google's published crawler behaviour. A tool by Sitefig."
msgstr "Analýza běží ve vašem prohlížeči. Párování pravidel se řídí RFC 9309 a chováním robotů zveřejněným Googlem. Nástroj od Sitefig."

msgctxt "sales.handoff.title"
msgid "Hand this to your developer"
msgstr "Předejte to svému vývojáři"

msgctxt "sales.handoff.body"
msgid "One message with every fix, the line numbers and the change to make. They will not need to run the check again."
msgstr "Jedna zpráva se všemi opravami, čísly řádků a změnou, kterou je třeba udělat. Vývojář nebude muset kontrolu spouštět znovu."

msgctxt "sales.compare.title"
msgid "Or compare with a competitor"
msgstr "Nebo se porovnejte s konkurentem"

msgctxt "sales.compare.body"
msgid "See side by side who search engines and AI can read. Both files are public. Free, once."
msgstr "Podívejte se vedle sebe, koho mohou vyhledávače a AI číst. Oba soubory jsou veřejné. Jednou zdarma."

