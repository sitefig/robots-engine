msgctxt "parser.tooLarge"
msgid "The file is {kib} KiB. Crawlers only read the first 500 KiB and ignore the rest."
msgstr "Il file è di {kib} KiB. I crawler leggono solo i primi 500 KiB e ignorano il resto."

msgctxt "parser.bom"
msgid "The file starts with a UTF-8 byte-order mark. Most parsers strip it, but saving without one is safer."
msgstr "Il file inizia con un byte-order mark UTF-8. La maggior parte dei parser lo rimuove, ma salvarlo senza è più sicuro."

msgctxt "parser.notFieldValue"
msgid "Line is not in \"field: value\" form and is ignored."
msgstr "La riga non è nella forma \"campo: valore\" e viene ignorata."

msgctxt "parser.misspelling"
msgid "\"{raw}\" is read as \"{field}\". Google tolerates the misspelling; other crawlers may not."
msgstr "\"{raw}\" viene letto come \"{field}\". Google tollera l'errore di battitura; altri crawler potrebbero non farlo."

msgctxt "parser.emptyUserAgent"
msgid "Empty User-agent value. This group matches no crawler."
msgstr "Valore User-agent vuoto. Questo gruppo non corrisponde a nessun crawler."

msgctxt "parser.invalidToken"
msgid "\"{value}\" is not a valid product token. This group matches no crawler."
msgstr "\"{value}\" non è un token di prodotto valido. Questo gruppo non corrisponde a nessun crawler."

msgctxt "parser.tokenTail"
msgid "Only \"{token}\" is used for matching. The rest of \"{value}\" is ignored."
msgstr "Solo \"{token}\" viene usato per la corrispondenza. Il resto di \"{value}\" viene ignorato."

msgctxt "parser.ruleBeforeAgent"
msgid "{directive} appears before any User-agent line and is ignored."
msgstr "{directive} compare prima di qualsiasi riga User-agent e viene ignorato."

msgctxt "parser.emptyAllow"
msgid "Empty Allow has no effect."
msgstr "Un Allow vuoto non ha effetto."

msgctxt "parser.emptyDisallow"
msgid "Empty Disallow means \"allow everything\" and has no effect."
msgstr "Un Disallow vuoto significa \"consenti tutto\" e non ha effetto."

msgctxt "parser.pathNoSlash"
msgid "Path \"{value}\" does not start with \"/\" and will never match. Did you mean \"/{value}\"?"
msgstr "Il percorso \"{value}\" non inizia con \"/\" e non corrisponderà mai. Intendevi \"/{value}\"?"

msgctxt "parser.crawlDelayBeforeAgent"
msgid "Crawl-delay appears before any User-agent line and is ignored."
msgstr "Crawl-delay compare prima di qualsiasi riga User-agent e viene ignorato."

msgctxt "parser.crawlDelayNaN"
msgid "Crawl-delay \"{value}\" is not a number."
msgstr "Crawl-delay \"{value}\" non è un numero."

msgctxt "parser.crawlDelayDuplicate"
msgid "Duplicate Crawl-delay in this group. The first one is kept."
msgstr "Crawl-delay duplicato in questo gruppo. Viene mantenuto il primo."

msgctxt "parser.crawlDelayNonStandard"
msgid "Crawl-delay is not part of RFC 9309. Bing honours it; Google and Yandex ignore it."
msgstr "Crawl-delay non fa parte della RFC 9309. Bing lo rispetta; Google e Yandex lo ignorano."

msgctxt "parser.sitemapInvalid"
msgid "Sitemap value \"{value}\" is not an absolute http(s) URL."
msgstr "Il valore Sitemap \"{value}\" non è un URL http(s) assoluto."

msgctxt "parser.hostDuplicate"
msgid "Duplicate Host. The first one is kept."
msgstr "Host duplicato. Viene mantenuto il primo."

msgctxt "parser.hostObsolete"
msgid "Host was a Yandex-only directive for naming the main mirror. Yandex dropped it in 2018; no crawler uses it now. Redirect to the preferred hostname instead."
msgstr "Host era una direttiva esclusiva di Yandex per indicare il mirror principale. Yandex l'ha abbandonata nel 2018; nessun crawler la usa più. Reindirizza piuttosto al nome host preferito."

msgctxt "parser.cleanParamMalformed"
msgid "Clean-param is malformed. Expected \"Clean-param: p1&p2 /path-prefix\" with parameter names made of letters, digits, \"_\", \"-\" and \".\"."
msgstr "Clean-param è malformato. Formato atteso: \"Clean-param: p1&p2 /prefisso-percorso\" con nomi di parametro composti da lettere, cifre, \"_\", \"-\" e \".\"."

msgctxt "parser.cleanParamTooLong"
msgid "Clean-param is longer than {max} characters, the limit Yandex accepts."
msgstr "Clean-param supera i {max} caratteri, il limite accettato da Yandex."

msgctxt "parser.cleanParamInfo"
msgid "Clean-param is a Yandex-only directive. Yandex ignores the listed query parameters when crawling; other crawlers ignore the directive."
msgstr "Clean-param è una direttiva esclusiva di Yandex. Yandex ignora i parametri di query elencati durante la scansione; gli altri crawler ignorano la direttiva."

msgctxt "parser.noindex"
msgid "Noindex in robots.txt is not supported by any major search engine. Use a robots meta tag or X-Robots-Tag header instead."
msgstr "Noindex nel robots.txt non è supportato da nessun grande motore di ricerca. Usa invece un meta tag robots o un header X-Robots-Tag."

msgctxt "parser.unknownDirective"
msgid "Unknown directive \"{field}\" is ignored."
msgstr "La direttiva sconosciuta \"{field}\" viene ignorata."

msgctxt "parser.noRules"
msgid "No rules found. Every crawler may access everything."
msgstr "Nessuna regola trovata. Ogni crawler può accedere a tutto."

msgctxt "parser.emptyGroup"
msgid "This group has no rules, so matching crawlers may access everything."
msgstr "Questo gruppo non ha regole, quindi i crawler corrispondenti possono accedere a tutto."

msgctxt "parser.tokenRepeated"
msgid "\"{token}\" appears in {n} groups. RFC 9309 merges their rules; some older crawlers only use the first."
msgstr "\"{token}\" compare in {n} gruppi. La RFC 9309 unisce le loro regole; alcuni crawler più vecchi usano solo il primo."

msgctxt "parser.starBlocksAll"
msgid "The \"*\" group disallows the whole site. Every crawler without its own group is blocked entirely."
msgstr "Il gruppo \"*\" vieta l'intero sito. Ogni crawler senza un gruppo proprio è completamente bloccato."

msgctxt "parser.noSitemap"
msgid "No Sitemap line. Optional, but it helps crawlers discover URLs."
msgstr "Nessuna riga Sitemap. Facoltativa, ma aiuta i crawler a scoprire gli URL."

msgctxt "seo.trailingSlash.allow"
msgid "Trailing slash trap: \"{path}\" is a prefix, so it also allows {path}s, {path}-old and {path}2. Did you mean \"{path}/\" for the directory, or \"{path}$\" for only that URL?"
msgstr "Trappola della barra finale: \"{path}\" è un prefisso, quindi consente anche {path}s, {path}-old e {path}2. Intendevi \"{path}/\" per la directory, o \"{path}$\" solo per quell'URL?"

msgctxt "seo.trailingSlash.disallow"
msgid "Trailing slash trap: \"{path}\" is a prefix, so it also blocks {path}s, {path}-old and {path}2. Did you mean \"{path}/\" for the directory, or \"{path}$\" for only that URL?"
msgstr "Trappola della barra finale: \"{path}\" è un prefisso, quindi blocca anche {path}s, {path}-old e {path}2. Intendevi \"{path}/\" per la directory, o \"{path}$\" solo per quell'URL?"

msgctxt "seo.selfBlock"
msgid "Self-block: \"Disallow: {path}\" matches /robots.txt. Google always fetches robots.txt regardless, but other crawlers may honour this and stop reading your rules altogether."
msgstr "Autoblocco: \"Disallow: {path}\" corrisponde a /robots.txt. Google recupera comunque sempre il robots.txt, ma altri crawler potrebbero rispettarlo e smettere del tutto di leggere le tue regole."

msgctxt "seo.caseSensitive"
msgid "Case-sensitive: \"{path}\" only matches URLs with exactly this casing. \"{lower}\" would not match. Check the site's real URL casing."
msgstr "Sensibile alle maiuscole: \"{path}\" corrisponde solo agli URL con esattamente questa scrittura. \"{lower}\" non corrisponderebbe. Controlla come sono scritti davvero gli URL del sito."

msgctxt "seo.duplicate"
msgid "Duplicate: \"{rule}\" repeats line {line}{scope}."
msgstr "Duplicato: \"{rule}\" ripete la riga {line}{scope}."

msgctxt "seo.redundant"
msgid "Redundant: \"{rule}\" never takes effect because \"{winner}\" on line {line} already covers every path it matches{scope}."
msgstr "Ridondante: \"{rule}\" non ha mai effetto perché \"{winner}\" alla riga {line} copre già ogni percorso a cui corrisponde{scope}."

msgctxt "seo.overridden"
msgid "Overridden: \"{rule}\" never wins because \"{winner}\" on line {line} takes precedence on every path it matches{scope}."
msgstr "Sovrascritta: \"{rule}\" non vince mai perché \"{winner}\" alla riga {line} ha la precedenza su ogni percorso a cui corrisponde{scope}."

msgctxt "seo.mergedScope"
msgid " (rules for \"{token}\" are merged across groups)"
msgstr " (le regole per \"{token}\" vengono unite tra i gruppi)"

msgctxt "sitemap.duplicate"
msgid "Duplicate Sitemap: this URL is already listed on line {line}."
msgstr "Sitemap duplicata: questo URL è già elencato alla riga {line}."

msgctxt "sitemap.protocolMismatch"
msgid "Protocol mismatch: the site is served over https but this sitemap is listed as http. Crawlers will hit a redirect on every fetch, or an insecure copy. Use {url}."
msgstr "Protocollo incoerente: il sito è servito via https ma questa sitemap è indicata come http. I crawler incontreranno un reindirizzamento a ogni recupero, o una copia non sicura. Usa {url}."

msgctxt "sitemap.httpsOnHttp"
msgid "The sitemap is https but the site was reached over http. Fine if the site redirects to https; otherwise list the sitemap with the protocol the site actually uses."
msgstr "La sitemap è https ma il sito è stato raggiunto via http. Va bene se il sito reindirizza a https; altrimenti indica la sitemap con il protocollo che il sito usa davvero."

msgctxt "sitemap.crossDomain"
msgid "Cross-domain sitemap: hosted on {host}, not {site}. Google only accepts it if both sites are verified by the same owner in Search Console (cross-site submission). Other search engines may ignore it."
msgstr "Sitemap su un altro dominio: ospitata su {host}, non su {site}. Google la accetta solo se entrambi i siti sono verificati dallo stesso proprietario in Search Console (invio tra siti). Altri motori potrebbero ignorarla."

msgctxt "sitemap.otherSubdomain"
msgid "The sitemap is on a different host of the same domain ({host}). Listing it here is what allows it to contain {site} URLs, so this is fine."
msgstr "La sitemap è su un altro host dello stesso dominio ({host}). Elencarla qui è ciò che le consente di contenere URL di {site}, quindi va bene."

msgctxt "lint.absoluteUrl"
msgid "\"{rule}\" is an absolute URL. Rules must be paths, so this never matches anything. It also publishes the hostname."
msgstr "\"{rule}\" è un URL assoluto. Le regole devono essere percorsi, quindi questa non corrisponde mai a nulla. Inoltre pubblica il nome host."

msgctxt "lint.absoluteUrl.hint"
msgid "\"{rule}\" is an absolute URL. Rules must be paths, so this never matches anything. Did you mean \"{path}\"? It also publishes the hostname."
msgstr "\"{rule}\" è un URL assoluto. Le regole devono essere percorsi, quindi questa non corrisponde mai a nulla. Intendevi \"{path}\"? Inoltre pubblica il nome host."

msgctxt "fetch.warn.redirectLimit"
msgid "More than five redirects. RFC 9309 lets crawlers give up at that point, and Google then treats the file as a 404: no restrictions."
msgstr "Più di cinque reindirizzamenti. La RFC 9309 permette ai crawler di arrendersi a quel punto, e Google tratta quindi il file come un 404: nessuna restrizione."

msgctxt "fetch.warn.redirectSameSite"
msgid "robots.txt redirected to {host}. A www/non-www or https redirect like this is fine; crawlers follow it."
msgstr "robots.txt ha reindirizzato a {host}. Un reindirizzamento www/non-www o https come questo va bene; i crawler lo seguono."

msgctxt "fetch.warn.redirectOtherHost"
msgid "robots.txt redirected to a different host, {to}. Crawlers apply the file they land on as this site's robots.txt, so {from} is governed by {to}'s rules."
msgstr "robots.txt ha reindirizzato a un altro host, {to}. I crawler applicano il file su cui atterrano come robots.txt di questo sito, quindi {from} è governato dalle regole di {to}."

msgctxt "fetch.warn.notRobotsPath"
msgid "The redirect ended at {path}, not /robots.txt. Crawlers still parse whatever they received as robots.txt."
msgstr "Il reindirizzamento è terminato su {path}, non su /robots.txt. I crawler analizzano comunque ciò che hanno ricevuto come robots.txt."

msgctxt "fetch.error.empty"
msgid "Enter a website URL."
msgstr "Inserisci l'URL di un sito web."

msgctxt "fetch.error.invalidUrl"
msgid "\"{input}\" is not a valid URL."
msgstr "\"{input}\" non è un URL valido."

msgctxt "fetch.error.unsupportedProtocol"
msgid "Only http and https URLs are supported."
msgstr "Sono supportati solo URL http e https."

msgctxt "fetch.error.notHostname"
msgid "\"{host}\" does not look like a hostname."
msgstr "\"{host}\" non sembra un nome host."

msgctxt "fetch.error.directTimeout"
msgid "Direct fetch timed out."
msgstr "Il recupero diretto è scaduto."

msgctxt "fetch.error.cors"
msgid "Direct fetch was blocked. The site does not send CORS headers for robots.txt."
msgstr "Il recupero diretto è stato bloccato. Il sito non invia header CORS per il robots.txt."

msgctxt "fetch.error.noProxy"
msgid "The proxy is not configured. Set WORKER_URL in js/config.js."
msgstr "Il proxy non è configurato. Imposta WORKER_URL in js/config.js."

msgctxt "fetch.error.proxyTimeout"
msgid "The proxy did not answer in time."
msgstr "Il proxy non ha risposto in tempo."

msgctxt "fetch.error.proxyUnreachable"
msgid "Could not reach the proxy."
msgstr "Impossibile raggiungere il proxy."

msgctxt "fetch.error.proxyUnreadable"
msgid "The proxy returned an unreadable response (HTTP {status})."
msgstr "Il proxy ha restituito una risposta illeggibile (HTTP {status})."

msgctxt "fetch.error.rateLimited"
msgid "Too many requests: the proxy is rate-limited right now. Wait a minute and try again."
msgstr "Troppe richieste: il proxy è al momento limitato. Attendi un minuto e riprova."

msgctxt "fetch.error.paused"
msgid "The proxy is switched off at the moment, so only sites that send CORS headers can be fetched. Paste the robots.txt instead."
msgstr "Il proxy è spento al momento, quindi si possono recuperare solo i siti che inviano header CORS. Incolla invece il robots.txt."

msgctxt "fetch.error.originRefused"
msgid "The proxy refused this page's origin. Add it to ALLOWED_ORIGINS in worker/wrangler.toml."
msgstr "Il proxy ha rifiutato l'origine di questa pagina. Aggiungila ad ALLOWED_ORIGINS in worker/wrangler.toml."

msgctxt "fetch.error.proxy"
msgid "Proxy error (HTTP {status}). {detail}"
msgstr "Errore del proxy (HTTP {status}). {detail}"

msgctxt "fetch.error.noProxyFallback"
msgid "{reason} No proxy is configured, so the file cannot be read. Paste its contents instead."
msgstr "{reason} Nessun proxy è configurato, quindi il file non può essere letto. Incolla invece il suo contenuto."

msgctxt "fetch.error.couldNotFetch"
msgid "Could not fetch {url}. {reason}"
msgstr "Impossibile recuperare {url}. {reason}"

msgctxt "security.reconWarning"
msgid "Security note: Disallow lines are publicly visible and often scanned by attackers for reconnaissance. robots.txt is not access control. Anything listed here should be protected by authentication, removed from the web root, or marked noindex with an HTTP header instead."
msgstr "Nota di sicurezza: le righe Disallow sono pubbliche e spesso scansionate dagli attaccanti a scopo di ricognizione. Il robots.txt non è un controllo degli accessi. Tutto ciò che è elencato qui andrebbe protetto con autenticazione, rimosso dalla web root o marcato noindex tramite header HTTP."

msgctxt "security.category.admin.label"
msgid "Admin / internal"
msgstr "Amministrazione / interno"

msgctxt "security.category.admin.advice"
msgid "Protect with authentication and send an X-Robots-Tag: noindex header. Listing it here only advertises where the login is."
msgstr "Proteggi con autenticazione e invia un header X-Robots-Tag: noindex. Elencarlo qui serve solo a far sapere dove si trova il login."

msgctxt "security.category.staging.label"
msgid "Staging / dev"
msgstr "Staging / sviluppo"

msgctxt "security.category.staging.advice"
msgid "Take staging and test environments off the public internet, or restrict them by IP or login. Use a noindex header rather than robots.txt."
msgstr "Togli gli ambienti di staging e test da Internet, oppure limitali per IP o login. Usa un header noindex anziché il robots.txt."

msgctxt "security.category.backups.label"
msgid "Backups & archives"
msgstr "Backup e archivi"

msgctxt "security.category.backups.advice"
msgid "Backups and archives should not be reachable over HTTP at all. Move them outside the web root and verify the URL returns 404."
msgstr "Backup e archivi non dovrebbero essere raggiungibili via HTTP affatto. Spostali fuori dalla web root e verifica che l'URL restituisca 404."

msgctxt "security.category.secrets.label"
msgid "Secrets & config"
msgstr "Segreti e configurazione"

msgctxt "security.category.secrets.advice"
msgid "Configuration files, version-control folders and credentials must never be web-accessible. Block them at the server and check they return 403 or 404."
msgstr "File di configurazione, cartelle di controllo versione e credenziali non devono mai essere accessibili dal web. Bloccali sul server e verifica che restituiscano 403 o 404."

msgctxt "security.category.api.label"
msgid "Private APIs & debug"
msgstr "API private e debug"

msgctxt "security.category.api.advice"
msgid "Internal APIs and debug endpoints need authentication or a network allowlist. Crawlers are not the threat here; scripted scanners are."
msgstr "API interne ed endpoint di debug richiedono autenticazione o una allowlist di rete. La minaccia qui non sono i crawler, ma gli scanner automatici."

msgctxt "security.category.data.label"
