msgstr "Engedélyezett"

msgctxt "enum.verdict.partial"
msgid "Restricted"
msgstr "Korlátozva"

msgctxt "enum.verdict.blocked"
msgid "Blocked"
msgstr "Tiltva"

msgctxt "enum.kind.syntax"
msgid "Syntax"
msgstr "Szintaxis"

msgctxt "enum.kind.seo-trap"
msgid "SEO trap"
msgstr "SEO-csapda"

msgctxt "enum.kind.sitemap"
msgid "Sitemap"
msgstr "Webhelytérkép"

msgctxt "enum.kind.fetch"
msgid "Fetch"
msgstr "Lekérés"

msgctxt "enum.kind.lint"
msgid "Lint"
msgstr "Lint"

msgctxt "enum.severity.high"
msgid "high"
msgstr "magas"

msgctxt "enum.severity.medium"
msgid "medium"
msgstr "közepes"

msgctxt "enum.severity.low"
msgid "low"
msgstr "alacsony"

