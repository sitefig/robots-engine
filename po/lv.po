msgctxt "page.title"
msgid "sus.bot | robots.txt checker"
msgstr "sus.bot | robots.txt pārbaudītājs"

msgctxt "page.description"
msgid "Free robots.txt checker. Fetch any site's robots.txt, see which search engines and AI crawlers are allowed or blocked, test paths against the rules, and check how the server responds to each crawler."
msgstr "Bezmaksas robots.txt pārbaude. Ielādējiet jebkuras vietnes robots.txt, skatiet, kuras meklētājprogrammas un kuri MI rāpuļi ir atļauti vai bloķēti, pārbaudiet ceļus pret noteikumiem un uzziniet, kā serveris atbild katram rāpulim."

msgctxt "page.skip"
msgid "Skip to content"
msgstr "Pāriet uz saturu"

msgctxt "page.h1"
msgid "Check and understand your robots.txt before traffic drops"
msgstr "Pārbaudiet un izprotiet savu robots.txt, pirms apmeklējumu skaits krītas"

msgctxt "page.themeLabel"
msgid "Colour theme"
msgstr "Krāsu motīvs"

msgctxt "ui.theme.toLight"
msgid "Switch to the light theme"
msgstr "Pārslēgties uz gaišo tēmu"

msgctxt "ui.theme.toDark"
msgid "Switch to the dark theme"
msgstr "Pārslēgties uz tumšo tēmu"

msgctxt "page.langLabel"
msgid "Language"
msgstr "Valoda"

msgctxt "page.intro"
msgid "Enter your domain above. You get a verdict for the business, a fix list that links to the exact lines, and a message you can send straight to IT."
msgstr "Ievadiet savu domēnu augšā. Jūs saņemsiet spriedumu biznesam, labojumu sarakstu ar norādēm uz precīzām rindām un ziņu, ko varat nosūtīt tieši IT."

msgctxt "page.urlLabel"
msgid "Domain, or any address on the site"
msgstr "Domēns vai jebkura vietnes adrese"

msgctxt "page.analyse"
msgid "Check robots.txt"
msgstr "Pārbaudīt robots.txt"

msgctxt "page.urlHint"
msgid "Paste whatever you have: a domain, a page, a link from an email, even the <code>robots.txt</code> address itself. We read <code>/robots.txt</code> from that site and ignore the rest."
msgstr "Ielīmējiet to, kas jums ir: domēnu, lapu, saiti no e-pasta vai pat pašu <code>robots.txt</code> adresi. Mēs nolasām šīs vietnes <code>/robots.txt</code> un pārējo ignorējam."

msgctxt "page.pasteSummary"
msgid "Paste a robots.txt instead"
msgstr "Vai ielīmējiet robots.txt"

msgctxt "page.pasteLabel"
msgid "robots.txt contents"
msgstr "robots.txt saturs"

msgctxt "page.analysePasted"
msgid "Analyse pasted text"
msgstr "Analizēt ielīmēto tekstu"

msgctxt "page.loadExample"
msgid "Load the kitchen-sink example"
msgstr "Ielādēt visaptverošo piemēru"

msgctxt "page.aiStatus"
msgid "AI scraping status"
msgstr "MI datu vākšanas statuss"

msgctxt "page.agents"
msgid "Crawler access"
msgstr "Rāpuļprogrammu piekļuve"

msgctxt "page.agentsIntro"
msgid "Resolved per crawler with RFC 9309 matching: the most specific group wins, then the longest rule, and ties go to <code>Allow</code>."
msgstr "Noteikts katram rāpulim pēc RFC 9309: uzvar specifiskākā grupa, tad garākais noteikums, bet neizšķirta gadījumā <code>Allow</code>."

msgctxt "page.tester"
msgid "Test a path"
msgstr "Pārbaudīt ceļu"

msgctxt "page.access"
msgid "Real access by crawler"
msgstr "Reālā piekļuve katram rāpulim"

msgctxt "page.accessIntro"
msgid "Request the file again through the proxy, identifying as each crawler in turn. A different status or body means the server treats that crawler differently (bot blocking, WAF rules, cloaking)."
msgstr "Pieprasa failu vēlreiz caur starpniekserveri, pēc kārtas identificējoties kā katrs rāpulis. Atšķirīgs statuss vai saturs nozīmē, ka serveris pret šo rāpuli izturas citādi (botu bloķēšana, WAF noteikumi, cloaking)."

msgctxt "page.issues"
msgid "Issues"
msgstr "Problēmas"

msgctxt "page.security"
msgid "Security notes"
msgstr "Drošības piezīmes"

msgctxt "page.securityIntro"
msgid "Disallow rules that name sensitive files and folders, which attackers look for first. This checks what the file reveals, not whether the paths exist or are protected."
msgstr "Disallow noteikumi, kas nosauc sensitīvus failus un mapes, ko uzbrucēji meklē vispirms. Tiek pārbaudīts, ko fails atklāj, nevis tas, vai ceļi pastāv vai ir aizsargāti."

msgctxt "page.recon"
msgid "Reconnaissance"
msgstr "Izlūkošana"

msgctxt "page.reconIntro"
msgid "What a stranger learns about this site from the file alone: the platform it runs on, cloud buckets, other hostnames, API entry points, data feeds, file types, and notes left in comments. Nothing here is fetched or probed; it is read straight from the text."
msgstr "Ko svešinieks uzzina par šo vietni tikai no faila: platformu, mākoņkrātuves, citus resursdatoru nosaukumus, API ieejas punktus, datu plūsmas, failu tipus un komentāros atstātās piezīmes. Nekas šeit netiek ielādēts vai pārbaudīts; viss tiek nolasīts tieši no teksta."

msgctxt "page.sitemaps"
msgid "Sitemaps"
msgstr "Vietnes kartes"

msgctxt "page.raw"
msgid "File contents"
msgstr "Faila saturs"

msgctxt "page.footerRfc"
msgid "Rule matching follows <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> and Google's published crawler behaviour."
msgstr "Noteikumu saskaņošana atbilst <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> un Google publicētajai rāpuļprogrammu uzvedībai."

msgctxt "page.footerBy"
msgid "A free tool by <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."
msgstr "Bezmaksas <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a> rīks."

msgctxt "page.noscript"
msgid "This tool runs entirely in your browser and needs JavaScript."
msgstr "Šis rīks darbojas pilnībā jūsu pārlūkā, un tam nepieciešams JavaScript."

msgctxt "enum.level.error"
msgid "Error"
msgstr "Kļūda"

msgctxt "enum.level.warning"
msgid "Warning"
msgstr "Brīdinājums"

msgctxt "enum.level.info"
msgid "Note"
msgstr "Piezīme"

msgctxt "enum.verdict.open"
msgid "Allowed"
msgstr "Atļauts"

msgctxt "enum.verdict.partial"
msgid "Restricted"
msgstr "Ierobežots"

msgctxt "enum.verdict.blocked"
msgid "Blocked"
msgstr "Bloķēts"

msgctxt "enum.kind.syntax"
msgid "Syntax"
msgstr "Sintakse"

msgctxt "enum.kind.seo-trap"
msgid "SEO trap"
msgstr "SEO slazds"

msgctxt "enum.kind.sitemap"
msgid "Sitemap"
msgstr "Vietnes karte"

msgctxt "enum.kind.fetch"
msgid "Fetch"
msgstr "Ielāde"

msgctxt "enum.kind.lint"
msgid "Lint"
msgstr "Lint"

msgctxt "enum.severity.high"
msgid "high"
msgstr "augsta"

msgctxt "enum.severity.medium"
msgid "medium"
msgstr "vidēja"

msgctxt "enum.severity.low"
msgid "low"
msgstr "zema"

msgctxt "enum.confidence.high"
msgid "high"
msgstr "augsta"

msgctxt "enum.confidence.medium"
msgid "medium"
msgstr "vidēja"

msgctxt "enum.confidence.low"
msgid "low"
msgstr "zema"

msgctxt "enum.risk.high"
msgid "high"
msgstr "augsts"

msgctxt "enum.risk.medium"
msgid "medium"
msgstr "vidējs"

msgctxt "enum.risk.low"
msgid "low"
msgstr "zems"

msgctxt "enum.role.search"
msgid "search"
msgstr "meklēšana"

msgctxt "enum.role.filter"
msgid "filter"
msgstr "filtrs"

msgctxt "enum.role.tracking"
msgid "tracking"
msgstr "izsekošana"

msgctxt "enum.role.other"
msgid "other"
msgstr "cits"

msgctxt "enum.relation.subdomain"
msgid "same domain"
msgstr "tas pats domēns"

msgctxt "enum.relation.ip"
msgid "IP address"
msgstr "IP adrese"

msgctxt "enum.relation.external"
msgid "other domain"
msgstr "cits domēns"

msgctxt "enum.source.comment"
msgid "comment"
