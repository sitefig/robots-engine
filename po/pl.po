msgstr "Wyszukiwarka You.com."

msgctxt "ai.noGroup"
msgid "No matching group, so everything is allowed."
msgstr "Brak pasującej grupy, więc wszystko jest dozwolone."

msgctxt "ai.ownGroup"
msgid "Has its own \"{token}\" group."
msgstr "Ma własną grupę „{token}”."

msgctxt "ai.starGroup"
msgid "Falls back to the \"*\" group."
msgstr "Korzysta z grupy „*”."

msgctxt "ai.headline"
msgid "{label}: {blocked} of {total} blocked"
msgstr "{label}: zablokowane {blocked} z {total}"

msgctxt "ai.callout.none"
msgid "No AI training crawlers are configured."
msgstr "Nie skonfigurowano crawlerów AI do trenowania."

msgctxt "ai.callout.allBlocked"
msgid "Every known AI training crawler is blocked."
msgstr "Wszystkie znane crawlery AI do trenowania są zablokowane."

msgctxt "ai.callout.noneRestricted"
msgid "No AI training crawler is restricted. Content on this site may be used for model training."
msgstr "Żaden crawler AI do trenowania nie jest ograniczony. Treści witryny mogą być używane do trenowania modeli."

msgctxt "ai.callout.noneNamed"
msgid "No AI training crawler is addressed by name; all of them follow the default \"*\" rules. Content may be used for model training."
msgstr "Żaden crawler AI do trenowania nie jest wymieniony z nazwy; wszystkie stosują domyślne reguły „*”. Treści mogą być używane do trenowania modeli."

msgctxt "ai.callout.uneven"
msgid "AI training crawlers are treated unevenly. Still allowed or only partly restricted: {list}."
msgstr "Crawlery AI do trenowania są traktowane nierówno. Nadal dozwolone lub tylko częściowo ograniczone: {list}."

