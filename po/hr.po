msgctxt "page.title"
msgid "sus.bot | robots.txt checker"
msgstr "sus.bot | provjera robots.txt"

msgctxt "page.description"
msgid "Free robots.txt checker. Fetch any site's robots.txt, see which search engines and AI crawlers are allowed or blocked, test paths against the rules, and check how the server responds to each crawler."
msgstr "Besplatna provjera robots.txt. Dohvatite robots.txt bilo koje stranice, vidite koje su tražilice i AI crawleri dopušteni ili blokirani, testirajte putanje prema pravilima i provjerite kako poslužitelj odgovara svakom crawleru."

msgctxt "page.skip"
msgid "Skip to content"
msgstr "Preskoči na sadržaj"

msgctxt "page.h1"
msgid "Check and understand your robots.txt before traffic drops"
msgstr "Provjerite i razumijte svoj robots.txt prije nego što promet padne"

msgctxt "page.themeLabel"
msgid "Colour theme"
msgstr "Tema boja"

msgctxt "ui.theme.toLight"
msgid "Switch to the light theme"
msgstr "Prebaci na svijetlu temu"

msgctxt "ui.theme.toDark"
msgid "Switch to the dark theme"
msgstr "Prebaci na tamnu temu"

msgctxt "page.langLabel"
msgid "Language"
msgstr "Jezik"

msgctxt "page.intro"
msgid "Enter your domain above. You get a verdict for the business, a fix list that links to the exact lines, and a message you can send straight to IT."
msgstr "Unesite svoju domenu gore. Dobivate presudu za poslovanje, popis ispravaka koji vodi na točne redove i poruku koju možete poslati ravno IT-u."

msgctxt "page.urlLabel"
msgid "Domain, or any address on the site"
msgstr "Domena ili bilo koja adresa na stranici"

msgctxt "page.analyse"
msgid "Check robots.txt"
msgstr "Provjeri robots.txt"

msgctxt "page.urlHint"
msgid "Paste whatever you have: a domain, a page, a link from an email, even the <code>robots.txt</code> address itself. We read <code>/robots.txt</code> from that site and ignore the rest."
msgstr "Zalijepite što god imate: domenu, podstranicu, poveznicu iz e-poruke, čak i samu adresu datoteke <code>robots.txt</code>. Čitamo <code>/robots.txt</code> s te stranice, a ostalo zanemarujemo."

msgctxt "page.pasteSummary"
msgid "Paste a robots.txt instead"
msgstr "Ili zalijepite robots.txt"

msgctxt "page.pasteLabel"
msgid "robots.txt contents"
msgstr "Sadržaj robots.txt"

msgctxt "page.analysePasted"
msgid "Analyse pasted text"
msgstr "Analiziraj zalijepljeni tekst"

msgctxt "page.loadExample"
msgid "Load the kitchen-sink example"
msgstr "Učitaj sveobuhvatni primjer"

msgctxt "page.aiStatus"
msgid "AI scraping status"
msgstr "Status AI prikupljanja"

msgctxt "page.agents"
msgid "Crawler access"
msgstr "Pristup alata za indeksiranje"

msgctxt "page.agentsIntro"
msgid "Resolved per crawler with RFC 9309 matching: the most specific group wins, then the longest rule, and ties go to <code>Allow</code>."
msgstr "Određeno po crawleru prema RFC 9309: pobjeđuje najspecifičnija grupa, zatim najdulje pravilo, a pri izjednačenju <code>Allow</code>."

msgctxt "page.tester"
msgid "Test a path"
msgstr "Testiraj putanju"

msgctxt "page.access"
msgid "Real access by crawler"
msgstr "Stvarni pristup po crawleru"

msgctxt "page.accessIntro"
msgid "Request the file again through the proxy, identifying as each crawler in turn. A different status or body means the server treats that crawler differently (bot blocking, WAF rules, cloaking)."
msgstr "Ponovno zatražite datoteku putem proxyja i pritom se redom predstavite kao svaki crawler. Drugačiji status ili sadržaj znači da poslužitelj taj crawler tretira drugačije (blokiranje botova, WAF pravila, cloaking)."

msgctxt "page.issues"
msgid "Issues"
msgstr "Problemi"

msgctxt "page.security"
msgid "Security notes"
msgstr "Sigurnosne napomene"

msgctxt "page.securityIntro"
msgid "Disallow rules that name sensitive files and folders, which attackers look for first. This checks what the file reveals, not whether the paths exist or are protected."
msgstr "Pravila Disallow koja navode osjetljive datoteke i mape, a njih napadači traže prve. Provjerava se što datoteka otkriva, a ne postoje li putanje ni jesu li zaštićene."

msgctxt "page.recon"
msgid "Reconnaissance"
msgstr "Izviđanje"

msgctxt "page.reconIntro"
msgid "What a stranger learns about this site from the file alone: the platform it runs on, cloud buckets, other hostnames, API entry points, data feeds, file types, and notes left in comments. Nothing here is fetched or probed; it is read straight from the text."
msgstr "Što stranac saznaje o ovoj stranici samo iz datoteke: platformu, cloud buckete, druga imena hostova, ulazne točke API-ja, podatkovne feedove, vrste datoteka i bilješke u komentarima. Ništa se ovdje ne dohvaća niti ispituje; čita se izravno iz teksta."

msgctxt "page.sitemaps"
msgid "Sitemaps"
msgstr "Sitemape"

msgctxt "page.raw"
msgid "File contents"
msgstr "Sadržaj datoteke"

msgctxt "page.footerRfc"
msgid "Rule matching follows <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> and Google's published crawler behaviour."
msgstr "Usklađivanje pravila slijedi <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> i Googleovo objavljeno ponašanje alata za indeksiranje."

msgctxt "page.footerBy"
msgid "A free tool by <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."
msgstr "Besplatan alat tvrtke <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."

msgctxt "page.noscript"
msgid "This tool runs entirely in your browser and needs JavaScript."
msgstr "Ovaj alat radi u potpunosti u vašem pregledniku i zahtijeva JavaScript."

