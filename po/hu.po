msgstr "Jelentések"

msgctxt "recon.data.feed.export"
msgid "Bulk export"
msgstr "Tömeges export"

msgctxt "recon.data.feed.catalogue"
msgid "Product catalogue feed"
msgstr "Termékkatalógus-adatfolyam"

msgctxt "recon.data.feed.content"
msgid "Content feed"
msgstr "Tartalom-adatfolyam"

msgctxt "recon.data.feed.file"
