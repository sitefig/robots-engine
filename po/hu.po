msgctxt "parser.tooLarge"
msgid "Crawlers stop reading this file after the first 500 KiB, so every rule after that point is ignored. The file is {kib} KiB."
msgstr "A robotok az első 500 KiB után abbahagyják a fájl olvasását, így az ez utáni szabályokat mind figyelmen kívül hagyják. A fájl mérete {kib} KiB."

msgctxt "parser.bom"
msgid "A crawler with a strict parser may misread the first line, because the file starts with a UTF-8 byte-order mark. Save the file without one."
msgstr "A szigorú értelmezőt használó robot félreolvashatja az első sort, mert a fájl UTF-8 bájtsorrendjelzővel (BOM) kezdődik. Mentse a fájlt e jelző nélkül."

msgctxt "parser.notFieldValue"
msgid "Crawlers ignore this line, because it is not written as \"directive: value\"."
msgstr "A robotok figyelmen kívül hagyják ezt a sort, mert nem „direktíva: érték” alakban van írva."

msgctxt "parser.misspelling"
msgid "Crawlers other than Google may skip this line, because \"{raw}\" is a misspelling of \"{field}\". Google reads it as \"{field}\"."
msgstr "A Google-ön kívüli robotok kihagyhatják ezt a sort, mert a benne álló „{raw}” elírás, a helyes alak „{field}”. A Google így olvassa: „{field}”."

msgctxt "parser.emptyUserAgent"
msgid "The rules under this line apply to no crawler, because the User-agent line names none."
msgstr "Az e sor alatti szabályok egyetlen robotra sem vonatkoznak, mert a User-agent sor egyet sem nevez meg."

msgctxt "parser.emptyUserAgent.others"
msgid "This line adds no crawler to the group, because the User-agent value is empty. The rules under it apply to {names}."
msgstr "Ez a sor egyetlen robotot sem ad a csoporthoz, mert a User-agent értéke üres. Az alatta lévő szabályok ezekre a robotokra vonatkoznak: {names}."

msgctxt "parser.emptyUserAgent.star"
msgid "This line adds no crawler to the group, because the User-agent value is empty. The rules under it apply to every crawler without its own rules."
msgstr "Ez a sor egyetlen robotot sem ad a csoporthoz, mert a User-agent értéke üres. Az alatta lévő szabályok minden olyan robotra vonatkoznak, amelynek nincsenek saját szabályai."

msgctxt "parser.invalidToken"
msgid "The rules under this line apply to no crawler, because \"{value}\" is not a valid crawler name."
msgstr "Az e sor alatti szabályok egyetlen robotra sem vonatkoznak, mert ez nem érvényes robotnév: „{value}”."

msgctxt "parser.invalidToken.others"
msgid "This line adds no crawler to the group, because \"{value}\" is not a valid crawler name. The rules under it apply to {names}."
msgstr "Ez a sor egyetlen robotot sem ad a csoporthoz, mert ez nem érvényes robotnév: „{value}”. Az alatta lévő szabályok ezekre a robotokra vonatkoznak: {names}."

msgctxt "parser.invalidToken.star"
msgid "This line adds no crawler to the group, because \"{value}\" is not a valid crawler name. The rules under it apply to every crawler without its own rules."
msgstr "Ez a sor egyetlen robotot sem ad a csoporthoz, mert ez nem érvényes robotnév: „{value}”. Az alatta lévő szabályok minden olyan robotra vonatkoznak, amelynek nincsenek saját szabályai."

msgctxt "parser.tokenTail"
msgid "These rules apply to \"{token}\", not to \"{value}\". Crawlers read only the name and ignore what follows it."
msgstr "Ezek a szabályok erre a robotra vonatkoznak: „{token}”, nem pedig erre: „{value}”. A robotok csak a nevet olvassák be, és figyelmen kívül hagyják, ami utána áll."

msgctxt "parser.ruleBeforeAgent"
msgid "Crawlers ignore this {directive} line, because it comes before any User-agent line."
msgstr "A robotok figyelmen kívül hagyják ezt a sort ({directive}), mert az első User-agent sor előtt áll."

msgctxt "parser.ruleBeforeAgent.disallow"
msgid "{outcome} This line was meant to block it, but it comes before any User-agent line, so crawlers ignore it."
msgstr "{outcome} Ennek a sornak kellett volna tiltania ezt a címet, de az első User-agent sor előtt áll, ezért a robotok figyelmen kívül hagyják."

msgctxt "parser.ruleBeforeAgent.allow"
msgid "{outcome} This line was meant to open it, but it comes before any User-agent line, so crawlers ignore it."
msgstr "{outcome} Ennek a sornak kellett volna megnyitnia ezt a címet, de az első User-agent sor előtt áll, ezért a robotok figyelmen kívül hagyják."

msgctxt "parser.emptyAllow"
msgid "This line changes nothing, because an Allow without a path matches no URL."
msgstr "Ez a sor semmin nem változtat, mert az útvonal nélküli Allow egyetlen URL-re sem illeszkedik."

msgctxt "parser.emptyDisallow"
msgid "This line blocks nothing, because a Disallow without a path leaves every URL open."
msgstr "Ez a sor semmit sem tilt, mert az útvonal nélküli Disallow minden URL-t nyitva hagy."

msgctxt "parser.pathNoSlash.disallow"
msgid "{outcome} This line was meant to block it, but \"{value}\" does not start with \"/\", so it matches no URL. Write \"/{value}\"."
msgstr "{outcome} Ennek a sornak kellett volna tiltania ezt a címet, de az érték („{value}”) nem „/” jellel kezdődik, ezért egyetlen URL-re sem illeszkedik. Ezt írja: „/{value}”."

msgctxt "parser.pathNoSlash.allow"
msgid "{outcome} This line was meant to open it, but \"{value}\" does not start with \"/\", so it matches no URL. Write \"/{value}\"."
msgstr "{outcome} Ennek a sornak kellett volna megnyitnia ezt a címet, de az érték („{value}”) nem „/” jellel kezdődik, ezért egyetlen URL-re sem illeszkedik. Ezt írja: „/{value}”."

msgctxt "parser.crawlDelayBeforeAgent"
msgid "No crawler slows down for this Crawl-delay line, because it comes before any User-agent line and is ignored."
msgstr "Egyetlen robot sem lassít e Crawl-delay sor miatt, mert az első User-agent sor előtt áll, ezért figyelmen kívül marad."

msgctxt "parser.crawlDelayNaN"
msgid "No crawler slows down for this line, because \"{value}\" is not a number."
msgstr "Egyetlen robot sem lassít e sor miatt, mert ez nem szám: „{value}”."

msgctxt "parser.crawlDelayDuplicate"
msgid "Crawlers ignore this Crawl-delay, because the group already has one and the first one is kept."
msgstr "A robotok figyelmen kívül hagyják ezt a Crawl-delay sort, mert a csoportban már van egy, és az első marad érvényben."

msgctxt "parser.crawlDelayNonStandard"
msgid "Only Bing slows down for Crawl-delay. Google and Yandex ignore it, because it is not part of RFC 9309."
msgstr "A Crawl-delay miatt csak a Bing lassít. A Google és a Yandex figyelmen kívül hagyja, mert nem része az RFC 9309-nek."

msgctxt "parser.sitemapInvalid"
msgid "Crawlers cannot find this sitemap, because \"{value}\" is not a full address that starts with http:// or https://."
msgstr "A robotok nem találják meg ezt a webhelytérképet, mert ez nem http:// vagy https:// kezdetű teljes cím: „{value}”."

msgctxt "parser.hostDuplicate"
msgid "This Host line is ignored, because the file already has one and the first one is kept."
msgstr "Ez a Host sor figyelmen kívül marad, mert a fájlban már van egy, és az első marad érvényben."

msgctxt "parser.hostObsolete"
msgid "No crawler reads this Host line. Host was a Yandex-only directive for naming the main mirror, and Yandex dropped it in 2018. Redirect to the preferred hostname instead."
msgstr "Ezt a Host sort egyetlen robot sem olvassa. A Host csak a Yandexnél létező direktíva volt, amely a fő tükröt nevezte meg, és a Yandex 2018-ban megszüntette. Helyette irányítson át az előnyben részesített hostnévre."

msgctxt "parser.cleanParamMalformed"
msgid "Yandex ignores this Clean-param line, because it is malformed. Write \"Clean-param: p1&p2 /path-prefix\", with parameter names made of letters, digits, \"_\", \"-\" and \".\"."
msgstr "A Yandex figyelmen kívül hagyja ezt a Clean-param sort, mert hibás a formátuma. Így írja: „Clean-param: p1&p2 /útvonal-előtag”, ahol a paraméternevek betűkből, számjegyekből, valamint „_”, „-” és „.” karakterekből állnak."

msgctxt "parser.cleanParamTooLong"
msgid "Yandex ignores this Clean-param line, because it is longer than the {max} characters Yandex accepts."
msgstr "A Yandex figyelmen kívül hagyja ezt a Clean-param sort, mert hosszabb, mint a Yandex által elfogadott {max} karakter."

msgctxt "parser.cleanParamInfo"
msgid "Only Yandex follows this line: it leaves out the listed query parameters when it crawls. Every other crawler ignores Clean-param."
msgstr "Ezt a sort csak a Yandex követi: feltérképezéskor kihagyja a felsorolt lekérdezési paramétereket. Minden más robot figyelmen kívül hagyja a Clean-param direktívát."

msgctxt "parser.noindex"
msgid "This line keeps no page out of search results, because no major search engine supports Noindex in robots.txt. Use a robots meta tag or the X-Robots-Tag header instead."
msgstr "Ez a sor egyetlen oldalt sem tart távol a keresési találatoktól, mert a robots.txt fájlba írt Noindex direktívát egyetlen nagy kereső sem támogatja. Használjon helyette robots metacímkét vagy X-Robots-Tag fejlécet."

msgctxt "parser.unknownDirective"
msgid "Crawlers ignore this line, because \"{field}\" is not a directive they know."
msgstr "A robotok figyelmen kívül hagyják ezt a sort, mert ezt a direktívát nem ismerik: „{field}”."

msgctxt "parser.noRules"
msgid "Every crawler may read every page, because the file holds no rules."
msgstr "Minden robot minden oldalt beolvashat, mert a fájlban nincs szabály."

msgctxt "parser.emptyGroup"
msgid "The crawlers this group names may read every page, because the group has no rules."
msgstr "A csoportban megnevezett robotok minden oldalt beolvashatnak, mert a csoportban nincs szabály."

msgctxt "parser.emptyGroup.merged"
msgid "This group adds no rules. The crawlers it names follow the rules of their other groups in this file."
msgstr "Ez a csoport nem ad hozzá szabályt. A benne megnevezett robotok a fájlban lévő többi csoportjuk szabályait követik."

msgctxt "parser.tokenRepeated"
msgid "Older crawlers may follow only part of the rules for \"{token}\", because the name appears in {n} groups. RFC 9309 merges the groups, but older crawlers may use only the first."
msgstr "A régebbi robotok az ehhez a névhez tartozó szabályoknak talán csak egy részét követik („{token}”), mert a név {n} csoportban szerepel. Az RFC 9309 összevonja a csoportokat, de a régebbi robotok lehet, hogy csak az elsőt használják."

msgctxt "parser.starBlocksAll"
msgid "The whole site is blocked for every crawler without its own group, because the \"*\" group disallows it."
msgstr "Az egész webhely tiltva van minden olyan robot számára, amelynek nincs saját csoportja, mert a „*” csoport tiltja."

msgctxt "parser.noSitemap"
msgid "Crawlers have to find new pages by following links, because the file lists no sitemap. A Sitemap line is optional, but it helps them."
msgstr "A robotoknak linkeket követve kell megtalálniuk az új oldalakat, mert a fájl nem sorol fel webhelytérképet. A Sitemap sor nem kötelező, de segít nekik."

msgctxt "seo.trailingSlash.allow"
msgid "URLs such as {path}s, {path}-old and {path}2 are open too, because \"{path}\" is a prefix and matches every URL that starts with it. Write \"{path}/\" for the directory, or \"{path}$\" for only that URL."
msgstr "Az olyan URL-ek is nyitva vannak, mint {path}s, {path}-old és {path}2, mert a megadott „{path}” előtag, és minden olyan URL-re illeszkedik, amely így kezdődik. A könyvtárhoz ezt írja: „{path}/”, ha pedig csak erre az egy URL-re gondol, ezt: „{path}$”."

msgctxt "seo.trailingSlash.disallow"
msgid "URLs such as {path}s, {path}-old and {path}2 are blocked too, because \"{path}\" is a prefix and matches every URL that starts with it. Write \"{path}/\" for the directory, or \"{path}$\" for only that URL."
msgstr "Az olyan URL-ek is tiltva vannak, mint {path}s, {path}-old és {path}2, mert a megadott „{path}” előtag, és minden olyan URL-re illeszkedik, amely így kezdődik. A könyvtárhoz ezt írja: „{path}/”, ha pedig csak erre az egy URL-re gondol, ezt: „{path}$”."

msgctxt "seo.selfBlock"
msgid "Crawlers other than Google may stop reading your rules altogether, because \"Disallow: {path}\" also matches /robots.txt. Google fetches robots.txt regardless."
msgstr "A Google-ön kívüli robotok teljesen abbahagyhatják a szabályai olvasását, mert a „Disallow: {path}” a /robots.txt fájlra is illeszkedik. A Google ettől függetlenül lekéri a robots.txt fájlt."

msgctxt "seo.caseSensitive"
msgid "{outcome} This line covers only URLs written exactly as \"{path}\", because paths are case-sensitive. Check the casing of the site's real URLs."
msgstr "{outcome} Ez a sor csak a pontosan így írt URL-ekre vonatkozik: „{path}”, mert az útvonalakban számít a kis- és nagybetű. Ellenőrizze, hogyan írja a webhely a valódi URL-eket."

msgctxt "seo.duplicate"
msgid "This line changes nothing, because \"{rule}\" repeats line {line}{scope}."
msgstr "Ez a sor semmin nem változtat, mert „{rule}” már szerepel itt: {line}. sor{scope}."

msgctxt "seo.redundant"
msgid "This line changes nothing, because every URL \"{rule}\" matches is already covered by \"{winner}\" on line {line}{scope}."
msgstr "Ez a sor semmin nem változtat, mert minden URL-t, amelyre „{rule}” illeszkedik, már lefed ez a szabály: „{winner}”, {line}. sor{scope}."

msgctxt "seo.overridden.disallow"
msgid "{path} stays open, because \"{winner}\" on line {line} wins over \"{rule}\" on every URL it matches{scope}."
msgstr "{path} nyitva marad, mert minden URL-en, amelyre „{rule}” illeszkedik, ez a szabály érvényesül helyette: „{winner}”, {line}. sor{scope}."

msgctxt "seo.overridden.allow"
msgid "{path} stays blocked, because \"{winner}\" on line {line} wins over \"{rule}\" on every URL it matches{scope}."
msgstr "{path} tiltva marad, mert minden URL-en, amelyre „{rule}” illeszkedik, ez a szabály érvényesül helyette: „{winner}”, {line}. sor{scope}."

msgctxt "seo.mergedScope"
msgid " (rules for \"{token}\" are merged across groups)"
msgstr " („{token}” szabályait több csoportból vonjuk össze)"

msgctxt "outcome.open.all"
msgid "{path} is open to every crawler."
msgstr "{path} nyitva van minden robot számára."

msgctxt "outcome.open.default"
msgid "{path} is open to every crawler without its own rules in this file."
msgstr "{path} nyitva van minden olyan robot számára, amelynek nincsenek saját szabályai ebben a fájlban."

msgctxt "outcome.open.named"
msgid "{path} is open to {names}."
msgstr "{path} nyitva van {names} számára."

msgctxt "outcome.allowed.all"
msgid "{path} is open to every crawler, because \"{winner}\" on line {line} allows it."
msgstr "{path} nyitva van minden robot számára, mert ez a szabály engedélyezi: „{winner}” ({line}. sor)."

msgctxt "outcome.allowed.default"
msgid "{path} is open to every crawler without its own rules in this file, because \"{winner}\" on line {line} allows it."
msgstr "{path} nyitva van minden olyan robot számára, amelynek nincsenek saját szabályai ebben a fájlban, mert ez a szabály engedélyezi: „{winner}” ({line}. sor)."

msgctxt "outcome.allowed.named"
msgid "{path} is open to {names}, because \"{winner}\" on line {line} allows it."
msgstr "{path} nyitva van {names} számára, mert ez a szabály engedélyezi: „{winner}” ({line}. sor)."

msgctxt "outcome.blocked.all"
msgid "{path} is blocked for every crawler, by \"{winner}\" on line {line}."
msgstr "{path} tiltva van minden robot számára, e szabály miatt: „{winner}” ({line}. sor)."

msgctxt "outcome.blocked.default"
msgid "{path} is blocked for every crawler without its own rules in this file, by \"{winner}\" on line {line}."
msgstr "{path} tiltva van minden olyan robot számára, amelynek nincsenek saját szabályai ebben a fájlban, e szabály miatt: „{winner}” ({line}. sor)."

msgctxt "outcome.blocked.named"
msgid "{path} is blocked for {names}, by \"{winner}\" on line {line}."
msgstr "{path} tiltva van {names} számára, e szabály miatt: „{winner}” ({line}. sor)."

msgctxt "outcome.names.more"
msgid "{names} and {n} more"
msgstr "{names} és további {n} robot"

msgctxt "sitemap.duplicate"
msgid "This line adds nothing, because the same sitemap is already listed on line {line}."
msgstr "Ez a sor semmit sem tesz hozzá, mert ugyanez a webhelytérkép már szerepel a fájlban ({line}. sor)."

msgctxt "sitemap.protocolMismatch"
msgid "Crawlers hit a redirect or an insecure copy every time they fetch this sitemap, because the site is served over https and the sitemap is listed as http. Use {url}."
msgstr "A robotok minden alkalommal átirányításba vagy nem biztonságos másolatba ütköznek, amikor lekérik ezt a webhelytérképet, mert a webhely https-en érhető el, a webhelytérkép viszont http-vel szerepel. Használja ezt: {url}."

msgctxt "sitemap.httpsOnHttp"
msgid "Crawlers fetch this sitemap over https, while the site was reached over http. This is fine if the site redirects to https; otherwise list the sitemap with the protocol the site uses."
msgstr "A robotok https-en kérik le ezt a webhelytérképet, a webhelyet viszont http-n értük el. Ez rendben van, ha a webhely https-re irányít át. Ha nem, azzal a protokollal adja meg a webhelytérképet, amelyet a webhely használ."

msgctxt "sitemap.crossDomain"
msgid "Search engines may ignore this sitemap, because it is hosted on {host} and not on {site}. Google accepts it only when both sites are verified by the same owner in Search Console (cross-site submission)."
msgstr "A keresők figyelmen kívül hagyhatják ezt a webhelytérképet, mert a tárhelye {host}, nem pedig {site}. A Google csak akkor fogadja el, ha a Search Console-ban mindkét webhelyet ugyanaz a tulajdonos igazolta (webhelyek közötti beküldés)."

msgctxt "sitemap.otherSubdomain"
msgid "Crawlers accept this sitemap. It sits on another host of the same domain ({host}), and listing it here is what allows it to contain {site} URLs."
msgstr "A robotok elfogadják ezt a webhelytérképet. Ugyanannak a domainnek egy másik hostján található ({host}), és éppen attól tartalmazhatja {site} URL-jeit, hogy itt fel van sorolva."

msgctxt "lint.absoluteUrl"
msgid "\"{rule}\" matches no URL, because a rule must be a path and this is a full address. The line also publishes the hostname."
msgstr "„{rule}” egyetlen URL-re sem illeszkedik, mert a szabálynak útvonalnak kell lennie, ez pedig teljes cím. A sor ráadásul nyilvánossá teszi a hostnevet."

msgctxt "lint.absoluteUrl.disallow"
msgid "{outcome} This line was meant to block it, but \"{rule}\" is a full address and a rule must be a path, so it matches no URL. Write \"{path}\". The line also publishes the hostname."
msgstr "{outcome} Ennek a sornak kellett volna tiltania ezt a címet, de „{rule}” teljes cím, a szabálynak pedig útvonalnak kell lennie, ezért egyetlen URL-re sem illeszkedik. Ezt írja: „{path}”. A sor ráadásul nyilvánossá teszi a hostnevet."

msgctxt "lint.absoluteUrl.allow"
msgid "{outcome} This line was meant to open it, but \"{rule}\" is a full address and a rule must be a path, so it matches no URL. Write \"{path}\". The line also publishes the hostname."
msgstr "{outcome} Ennek a sornak kellett volna megnyitnia ezt a címet, de „{rule}” teljes cím, a szabálynak pedig útvonalnak kell lennie, ezért egyetlen URL-re sem illeszkedik. Ezt írja: „{path}”. A sor ráadásul nyilvánossá teszi a hostnevet."

msgctxt "fetch.warn.redirectLimit"
msgid "Google treats this site as having no robots.txt, so no page is restricted. The file sits behind more than five redirects, and RFC 9309 lets crawlers give up at that point."
msgstr "A Google úgy kezeli ezt a webhelyet, mintha nem lenne robots.txt fájlja, így egyetlen oldal sincs korlátozva. A fájl ötnél több átirányítás mögött van, és az RFC 9309 megengedi, hogy a robotok ezen a ponton feladják."

msgctxt "fetch.warn.redirectSameSite"
msgid "Crawlers still reach the file. robots.txt redirects to {host}, and crawlers follow a www or https redirect like this one."
msgstr "A robotok így is elérik a fájlt. A robots.txt ide irányít át: {host}, és a robotok követik az ilyen, www-s címre vagy https-re vezető átirányítást."

msgctxt "fetch.warn.redirectOtherHost"
msgid "{from} is governed by the rules of {to}, because robots.txt redirects to that host and crawlers apply the file they land on."
msgstr "{from} feltérképezését {to} szabályai határozzák meg, mert a robots.txt arra a hostra irányít át, és a robotok azt a fájlt alkalmazzák, amelyhez megérkeznek."

msgctxt "fetch.warn.notRobotsPath"
msgid "Crawlers read the content of {path} as your robots.txt, because the redirect ended there and not at /robots.txt."
msgstr "A robotok ennek a címnek a tartalmát olvassák az Ön robots.txt fájljaként: {path}, mert az átirányítás ott ért véget, nem a /robots.txt címen."

msgctxt "fetch.error.empty"
msgid "Enter a website URL."
msgstr "Adja meg egy webhely URL-jét."

msgctxt "fetch.error.invalidUrl"
msgid "\"{input}\" is not a valid URL."
msgstr "Érvénytelen URL: „{input}”."

msgctxt "fetch.error.unsupportedProtocol"
msgid "Only http and https URLs are supported."
msgstr "Csak http és https URL-ek támogatottak."

msgctxt "fetch.error.notHostname"
msgid "\"{host}\" does not look like a hostname."
msgstr "Ez nem tűnik hostnévnek: „{host}”."

msgctxt "fetch.error.directTimeout"
msgid "Direct fetch timed out."
msgstr "A közvetlen lekérés túllépte az időkorlátot."

msgctxt "fetch.error.cors"
msgid "Direct fetch was blocked. The site does not send CORS headers for robots.txt."
msgstr "A közvetlen lekérést a böngésző blokkolta. A webhely nem küld CORS-fejléceket a robots.txt fájlhoz."

msgctxt "fetch.error.noProxy"
msgid "The proxy is not configured. Set WORKER_URL in js/config.js."
msgstr "A proxy nincs beállítva. Adja meg a WORKER_URL értékét a js/config.js fájlban."

msgctxt "fetch.error.proxyTimeout"
msgid "The proxy did not answer in time."
msgstr "A proxy nem válaszolt időben."

msgctxt "fetch.error.proxyUnreachable"
msgid "Could not reach the proxy."
msgstr "A proxy nem érhető el."

msgctxt "fetch.error.proxyUnreadable"
msgid "The proxy returned an unreadable response (HTTP {status})."
msgstr "A proxy olvashatatlan választ adott (HTTP {status})."

msgctxt "fetch.error.rateLimited"
msgid "Too many requests: the proxy is rate-limited right now. Wait a minute and try again."
msgstr "Túl sok kérés: a proxy most korlátozza a kérések számát. Várjon egy percet, és próbálja újra."

msgctxt "fetch.error.paused"
msgid "The proxy is switched off at the moment, so only sites that send CORS headers can be fetched. Paste the robots.txt instead."
msgstr "A proxy jelenleg ki van kapcsolva, ezért csak olyan webhelyek kérhetők le, amelyek CORS-fejléceket küldenek. Illessze be inkább a robots.txt tartalmát."

msgctxt "fetch.error.originRefused"
msgid "The proxy refused this page's origin. Add it to ALLOWED_ORIGINS in worker/wrangler.toml."
msgstr "A proxy elutasította ennek az oldalnak az origóját. Vegye fel az ALLOWED_ORIGINS listára a worker/wrangler.toml fájlban."

msgctxt "fetch.error.proxy"
msgid "Proxy error (HTTP {status}). {detail}"
msgstr "Proxyhiba (HTTP {status}). {detail}"

msgctxt "fetch.error.noProxyFallback"
msgid "{reason} No proxy is configured, so the file cannot be read. Paste its contents instead."
msgstr "{reason} Nincs proxy beállítva, ezért a fájl nem olvasható be. Illessze be inkább a tartalmát."

msgctxt "fetch.error.couldNotFetch"
msgid "Could not fetch {url}. {reason}"
msgstr "Nem sikerült lekérni: {url}. {reason}"

msgctxt "security.reconWarning"
msgid "Attackers read the Disallow lines of this file to decide where to look first, because robots.txt is public and is not access control. Protect every path listed here with authentication, remove it from the web root, or mark it noindex with an HTTP header."
msgstr "A támadók e fájl Disallow soraiból döntik el, hol nézzenek körül először, mert a robots.txt nyilvános, és nem hozzáférés-szabályozás. Az itt felsorolt útvonalak mindegyikét védje hitelesítéssel, távolítsa el a webgyökérből, vagy jelölje meg noindex értékkel egy HTTP-fejlécben."

msgctxt "security.category.admin.label"
msgid "Admin / internal"
msgstr "Admin / belső"

msgctxt "security.category.admin.advice"
msgid "Protect with authentication and send an X-Robots-Tag: noindex header. Listing it here only advertises where the login is."
msgstr "Védje hitelesítéssel, és küldjön X-Robots-Tag: noindex fejlécet. Ha itt felsorolja, azzal csak azt hirdeti, hol van a bejelentkezés."

msgctxt "security.category.staging.label"
msgid "Staging / dev"
msgstr "Staging / fejlesztés"

msgctxt "security.category.staging.advice"
msgid "Take staging and test environments off the public internet, or restrict them by IP or login. Use a noindex header rather than robots.txt."
msgstr "A staging- és tesztkörnyezeteket vegye le a nyilvános internetről, vagy korlátozza a hozzáférést IP-cím vagy bejelentkezés alapján. A robots.txt helyett noindex fejlécet használjon."

msgctxt "security.category.backups.label"
msgid "Backups & archives"
msgstr "Mentések és archívumok"

msgctxt "security.category.backups.advice"
msgid "Backups and archives should not be reachable over HTTP at all. Move them outside the web root and verify the URL returns 404."
msgstr "A mentések és archívumok egyáltalán ne legyenek elérhetők HTTP-n. Helyezze őket a webgyökéren kívülre, és ellenőrizze, hogy az URL 404-et ad vissza."

msgctxt "security.category.secrets.label"
msgid "Secrets & config"
msgstr "Titkok és konfiguráció"

msgctxt "security.category.secrets.advice"
msgid "Configuration files, version-control folders and credentials must never be web-accessible. Block them at the server and check they return 403 or 404."
msgstr "A konfigurációs fájlok, a verziókezelő mappái és a hitelesítő adatok soha nem lehetnek elérhetők a weben. Tiltsa le őket a szerveren, és ellenőrizze, hogy 403-at vagy 404-et adnak vissza."

msgctxt "security.category.api.label"
msgid "Private APIs & debug"
msgstr "Privát API-k és hibakeresés"

msgctxt "security.category.api.advice"
msgid "Internal APIs and debug endpoints need authentication or a network allowlist. Crawlers are not the threat here; scripted scanners are."
msgstr "A belső API-khoz és a hibakereső végpontokhoz hitelesítés vagy hálózati engedélylista kell. Itt nem a robotok jelentik a veszélyt, hanem az automatizált szkennerek."

msgctxt "security.category.data.label"
msgid "User data & uploads"
msgstr "Felhasználói adatok és feltöltések"

msgctxt "security.category.data.advice"
msgid "Turn off directory listing and make sure private files require a login. A Disallow only asks polite crawlers to look away."
msgstr "Kapcsolja ki a könyvtárlistázást, és gondoskodjon róla, hogy a privát fájlokhoz bejelentkezés kelljen. A Disallow csak megkéri az udvarias robotokat, hogy ne nézzenek oda."

msgctxt "security.reason.admin"
msgid "Administrative interface"
msgstr "Adminisztrációs felület"

msgctxt "security.reason.staging"
msgid "Non-production environment"
msgstr "Nem éles környezet"

msgctxt "security.reason.versioned"
msgid "Versioned path, often an old or unreleased version"
msgstr "Verziózott útvonal, gyakran régi vagy még ki nem adott verzió"

msgctxt "security.reason.configFile"
msgid "Configuration, version control or credential file"
msgstr "Konfigurációs, verziókezelő vagy hitelesítő adatokat tartalmazó fájl"

msgctxt "security.reason.secrets"
msgid "Secrets or credentials location"
msgstr "Titkok vagy hitelesítő adatok helye"

msgctxt "security.reason.backupDir"
msgid "Backup or database dump location"
msgstr "Mentések vagy adatbázisdumpok helye"

msgctxt "security.reason.backupFile"
msgid "Backup or archive file type"
msgstr "Mentés vagy archívum fájltípusa"

msgctxt "security.reason.api"
msgid "Internal API or debug endpoint"
msgstr "Belső API vagy hibakereső végpont"

msgctxt "security.reason.data"
msgid "User data, uploads or exports"
msgstr "Felhasználói adatok, feltöltések vagy exportok"

msgctxt "agents.category.search"
msgid "Search engines"
msgstr "Keresők"

msgctxt "agents.category.ai-training"
msgid "AI training / LLMs"
msgstr "AI-tanítás / LLM-ek"

msgctxt "agents.category.ai-search"
msgid "AI search / citations"
msgstr "AI-keresés / hivatkozások"

msgctxt "agents.category.social"
msgid "Social previews"
msgstr "Közösségi előnézetek"

msgctxt "agents.category.seo"
msgid "SEO tools"
msgstr "SEO-eszközök"

msgctxt "agents.note.gptbot"
msgid "OpenAI model training."
msgstr "Az OpenAI modelltanítása."

msgctxt "agents.note.claudebot"
msgid "Anthropic model training. Also honours the older \"anthropic-ai\" token."
msgstr "Az Anthropic modelltanítása. A régebbi „anthropic-ai” tokent is figyelembe veszi."

msgctxt "agents.note.googleExtended"
msgid "Control token for Gemini training. Not a crawler; Googlebot fetches the pages."
msgstr "Vezérlőtoken a Gemini tanításához. Nem robot, az oldalakat a Googlebot kéri le."

msgctxt "agents.note.applebotExtended"
msgid "Control token for Apple model training. Applebot fetches the pages."
msgstr "Vezérlőtoken az Apple modelltanításához. Az oldalakat az Applebot kéri le."

msgctxt "agents.note.ccbot"
msgid "Common Crawl. Its archive is a major training source for many models."
msgstr "Common Crawl. Az archívuma sok modell fontos tanítási forrása."

msgctxt "agents.note.bytespider"
msgid "ByteDance / TikTok."
msgstr "ByteDance / TikTok."

msgctxt "agents.note.metaExternalagent"
msgid "Meta model training."
msgstr "A Meta modelltanítása."

msgctxt "agents.note.amazonbot"
msgid "Amazon, used for Alexa and model training."
msgstr "Amazon, az Alexához és modelltanításhoz használják."

msgctxt "agents.note.diffbot"
msgid "Structured-data extraction and knowledge graph."
msgstr "Strukturált adatok kinyerése és tudásgráf."

msgctxt "agents.note.cohere"
msgid "Control token for Cohere model training."
msgstr "Vezérlőtoken a Cohere modelltanításához."

msgctxt "agents.note.omgilibot"
msgid "Webz.io, which resells crawled data for training."
msgstr "Webz.io, amely a feltérképezett adatokat tanítási célra értékesíti tovább."

msgctxt "agents.note.oaiSearchbot"
msgid "ChatGPT search index. Not used for training."
msgstr "A ChatGPT keresőindexe. Tanításra nem használják."

msgctxt "agents.note.chatgptUser"
msgid "Fetches pages on a user's request inside ChatGPT."
msgstr "A ChatGPT-ben egy felhasználó kérésére kér le oldalakat."

msgctxt "agents.note.claudeSearchbot"
msgid "Anthropic search index. Not used for training."
msgstr "Az Anthropic keresőindexe. Tanításra nem használják."

msgctxt "agents.note.claudeUser"
msgid "Fetches pages on a user's request inside Claude."
msgstr "A Claude-ban egy felhasználó kérésére kér le oldalakat."

msgctxt "agents.note.perplexitybot"
msgid "Perplexity search index."
msgstr "A Perplexity keresőindexe."

msgctxt "agents.note.perplexityUser"
msgid "Fetches pages on a user's request inside Perplexity."
msgstr "A Perplexityben egy felhasználó kérésére kér le oldalakat."

msgctxt "agents.note.duckassistbot"
msgid "DuckDuckGo AI answers."
msgstr "A DuckDuckGo AI-válaszai."

msgctxt "agents.note.youbot"
msgid "You.com search."
msgstr "A You.com keresője."

msgctxt "ai.noGroup"
msgid "No matching group, so everything is allowed."
msgstr "Nincs illeszkedő csoport, ezért minden engedélyezett."

msgctxt "ai.ownGroup"
msgid "Has its own \"{token}\" group."
msgstr "Saját „{token}” csoportja van."

msgctxt "ai.starGroup"
msgid "Falls back to the \"*\" group."
msgstr "A „*” csoportot használja."

msgctxt "ai.headline"
msgid "{label}: {blocked} of {total} blocked"
msgstr "{label}: {blocked} / {total} tiltva"

msgctxt "ai.callout.none"
msgid "No AI training crawlers are configured."
msgstr "Nincsenek beállítva AI-tanító robotok."

msgctxt "ai.callout.allBlocked"
msgid "Every known AI training crawler is blocked."
msgstr "Minden ismert AI-tanító robot tiltva van."

msgctxt "ai.callout.noneRestricted"
msgid "No AI training crawler is restricted. Content on this site may be used for model training."
msgstr "Egyetlen AI-tanító robot sincs korlátozva. Az oldal tartalma modelltanításra használható."

msgctxt "ai.callout.noneNamed"
msgid "No AI training crawler is addressed by name; all of them follow the default \"*\" rules. Content may be used for model training."
msgstr "Egyetlen AI-tanító robot sincs név szerint megadva; mind az alapértelmezett „*” szabályokat követik. A tartalom modelltanításra használható."

msgctxt "ai.callout.uneven"
msgid "AI training crawlers are treated unevenly. Still allowed or only partly restricted: {list}."
msgstr "Az AI-tanító robotokat eltérően kezeli. Még engedélyezett vagy csak részben korlátozott: {list}."

