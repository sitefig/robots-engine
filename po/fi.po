msgid "Parts of {site} are hidden"
msgstr "Osa sivustosta {site} on piilotettu"

msgctxt "ui.summary.allBlocked.titleSite"
msgid "All of {site} is closed to search engines"
msgstr "Koko sivusto {site} on suljettu hakukoneilta"

msgctxt "ui.summary.open.titleSite"
msgid "All of {site} is open to everyone"
msgstr "Koko sivusto {site} on avoinna kaikille"

msgctxt "ui.summary.notFound.titleSite"
msgid "{site} has no robots.txt at all"
msgstr "Sivustolla {site} ei ole robots.txt-tiedostoa lainkaan"

msgctxt "ui.summary.serverError.titleSite"
msgid "The server at {site} is not handing the file over"
msgstr "Sivuston {site} palvelin ei toimita tiedostoa"

