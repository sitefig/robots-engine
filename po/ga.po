msgctxt "md.actions.trailingSlash"
msgid "Decide whether {rules} should end in \"/\" (directory) or \"$\" (exact URL); as written they also match longer paths{where}."
msgstr "Socraigh ar cheart do {rules} críochnú le \"/\" (comhadlann) nó le \"$\" (URL beacht); mar atá siad scríofa, tagann siad le cosáin níos faide freisin{where}."

msgctxt "md.actions.selfBlock"
msgid "Remove the rule that matches /robots.txt itself{where}."
msgstr "Bain an riail a thagann le /robots.txt féin{where}."

msgctxt "md.actions.deadRules"
msgid "Remove {rules} that never take effect{where}."
msgstr "Bain {rules} nach mbíonn éifeacht acu choíche{where}."

msgctxt "md.actions.absoluteUrl"
msgid "Rewrite {rules} as paths{where}."
msgstr "Athscríobh {rules} mar chosáin{where}."

msgctxt "md.actions.noSlash"
msgid "Add the leading \"/\" to {paths} that can never match{where}."
msgstr "Cuir an \"/\" tosaigh le {paths} nach féidir leo teacht le haon rud choíche{where}."

msgctxt "md.actions.protocol"
msgid "List sitemaps with https URLs{where}."
msgstr "Liostaigh léarscáileanna suímh le URLanna https{where}."

msgctxt "md.actions.crossDomain"
msgid "Verify cross-domain sitemap ownership in Search Console, or move {sitemaps} onto this domain{where}."
msgstr "Fíoraigh úinéireacht na léarscáile suímh trasfhearainn in Search Console, nó bog {sitemaps} go dtí an fearann seo{where}."

msgctxt "md.actions.relativeSitemap"
msgid "Make {lines} absolute URLs{where}."
msgstr "Déan URLanna absalóideacha de {lines}{where}."

msgctxt "md.actions.addSitemap"
msgid "Add a Sitemap line pointing at the XML sitemap."
msgstr "Cuir líne Sitemap leis a dhíríonn ar an léarscáil suímh XML."

msgctxt "md.actions.noindex"
msgid "Move noindex out of robots.txt into a robots meta tag or X-Robots-Tag header; no search engine honours it here."
msgstr "Bog noindex amach as robots.txt go clib meta robots nó ceanntásc X-Robots-Tag; ní ghéilleann aon inneall cuardaigh dó anseo."

msgctxt "md.actions.crawlDelay"
msgid "Treat Crawl-delay as Bing-only; use Search Console crawl settings for Google."
msgstr "Caith le Crawl-delay mar threoir do Bing amháin; úsáid socruithe crawlála Search Console le haghaidh Google."

msgctxt "md.actions.starBlocked"
msgid "Confirm that blocking the whole site for every crawler without its own group is intended."
msgstr "Deimhnigh gur d'aon ghnó atá an suíomh ar fad blocáilte do gach crawler nach bhfuil a ghrúpa féin aige."

msgctxt "md.actions.security"
msgid "{label}: {advice} Paths: {paths}{more}."
msgstr "{label}: {advice} Cosáin: {paths}{more}."

msgctxt "md.actions.more"
msgid " and {n} more"
msgstr " agus {n} eile"

msgctxt "md.actions.aiUneven"
msgid "Decide on one AI-training policy. Still allowed or only partly restricted: {list}."
msgstr "Socraigh ar pholasaí amháin d'oiliúint AI. Fós ceadaithe nó srianta go páirteach amháin: {list}."

msgctxt "md.actions.aiDecide"
msgid "Decide whether AI training crawlers (GPTBot, ClaudeBot, CCBot and others) should be allowed; none is restricted today."
msgstr "Socraigh ar cheart crawlers oiliúna AI (GPTBot, ClaudeBot, CCBot agus eile) a cheadú; níl aon cheann srianta inniu."

msgctxt "md.actions.buckets"
msgid "Check permissions on the cloud buckets named in the file: {list}."
msgstr "Seiceáil na ceadanna ar na buicéid néil atá ainmnithe sa chomhad: {list}."

msgctxt "md.actions.envHosts"
msgid "Remove non-production hostnames from the file and put those environments behind authentication: {list}."
msgstr "Bain óstainmneacha neamhtháirgthe den chomhad agus cuir na timpeallachtaí sin taobh thiar d'fhíordheimhniú: {list}."

msgctxt "md.actions.personal"
msgid "Strip names, email addresses, IPs and ticket IDs from comments; the file is public."
msgstr "Bain ainmneacha, seoltaí ríomhphoist, seoltaí IP agus aitheantóirí ticéad de na tráchtanna; tá an comhad poiblí."

msgctxt "md.actions.bom"
msgid "Save the file as UTF-8 without a byte-order mark."
msgstr "Sábháil an comhad mar UTF-8 gan marc ord beart."

msgctxt "md.actions.none"
msgid "No action needed. The file is clean."
msgstr "Ní gá aon rud a dhéanamh. Tá an comhad glan."

