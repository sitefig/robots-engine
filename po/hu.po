msgstr "Backend keretrendszer"

msgctxt "recon.cloud.kind.storage"
msgid "Object storage"
msgstr "Objektumtároló"

msgctxt "recon.cloud.kind.cdn"
msgid "CDN"
msgstr "CDN"

msgctxt "recon.cloud.kind.hosting"
msgid "Hosting"
msgstr "Tárhely"

msgctxt "recon.cloud.kind.platform"
msgid "Platform CDN"
msgstr "Platform CDN-je"

msgctxt "recon.cloud.risk.storage"
msgid "Bucket and account names can be probed for public listing, read or write permissions."
msgstr "A bucket- és fióknevek alapján kipróbálható, hogy van-e nyilvános listázási, olvasási vagy írási jogosultság."

msgctxt "recon.cloud.risk.cdn"
msgid "Reveals the CDN vendor and distribution or account identifier."
msgstr "Elárulja a CDN-szolgáltatót és a disztribúció vagy a fiók azonosítóját."

msgctxt "recon.cloud.risk.hosting"
msgid "Reveals the hosting provider and project name, often for a non-production copy."
msgstr "Elárulja a tárhelyszolgáltatót és a projekt nevét, gyakran egy nem éles másolatét."

msgctxt "recon.cloud.risk.platform"
msgid "Confirms the site platform and its asset store."
msgstr "Megerősíti, milyen platformon fut a webhely, és hol tárolja a statikus fájljait."

msgctxt "recon.hosts.privateIp"
msgid "private IP"
msgstr "privát IP"

msgctxt "recon.api.kind.graphql"
msgid "GraphQL"
msgstr "GraphQL"

msgctxt "recon.api.kind.docs"
msgid "API docs & schemas"
msgstr "API-dokumentáció és sémák"

msgctxt "recon.api.kind.gateway"
msgid "API gateways & endpoints"
msgstr "API-átjárók és végpontok"

msgctxt "recon.api.kind.rpc"
msgid "RPC & realtime"
msgstr "RPC és valós idejű végpontok"

msgctxt "recon.api.kind.ops"
msgid "Health, metrics & debug"
msgstr "Állapot, metrikák és hibakeresés"

msgctxt "recon.api.note.graphql"
msgid "Introspection may expose the whole schema; playgrounds often lack authentication."
msgstr "Az introspekció a teljes sémát felfedheti, a playgroundok pedig gyakran nem kérnek hitelesítést."

msgctxt "recon.api.note.docs"
msgid "Interactive docs and OpenAPI files list every endpoint and parameter."
msgstr "Az interaktív dokumentáció és az OpenAPI-fájlok minden végpontot és paramétert felsorolnak."

msgctxt "recon.api.note.gateway"
msgid "Raw entry points to test for missing authentication and rate limits."
msgstr "Nyers belépési pontok, amelyeken kipróbálható, hiányzik-e a hitelesítés vagy a kéréskorlát."

msgctxt "recon.api.note.rpc"
msgid "Legacy RPC and realtime endpoints are frequent sources of unauthenticated methods."
msgstr "A régi RPC- és valós idejű végpontok között gyakran akad hitelesítés nélkül hívható metódus."

msgctxt "recon.api.note.ops"
msgid "Operational endpoints can leak config, environment variables and internal hostnames."
msgstr "Az üzemeltetési végpontok kiszivárogtathatják a konfigurációt, a környezeti változókat és a belső hostneveket."

msgctxt "recon.data.feed.merchant"
msgid "Shopping / merchant feed"
msgstr "Shopping / kereskedői adatfolyam"

msgctxt "recon.data.feed.inventory"
msgid "Inventory or stock data"
msgstr "Készlet- vagy raktáradatok"

msgctxt "recon.data.feed.prices"
msgid "Price list"
msgstr "Árlista"

msgctxt "recon.data.feed.reports"
