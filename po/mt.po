"Plural-Forms: nplurals=5; plural=(n == 1 ? 0 : n == 2 ? 1 : n == 0 || (n % 100 >= 3 && n % 100 <= 10) ? 2 : n % 100 >= 11 && n % 100 <= 19 ? 3 : 4);\n"

msgctxt "page.title"
msgid "sus.bot | robots.txt checker"
msgstr "sus.bot | verifika tar-robots.txt"

msgctxt "page.description"
msgid "Free robots.txt checker. Fetch any site's robots.txt, see which search engines and AI crawlers are allowed or blocked, test paths against the rules, and check how the server responds to each crawler."
msgstr "Verifikatur tar-robots.txt b’xejn. Niżżel ir-robots.txt ta’ kwalunkwe sit, ara liema magni tat-tiftix u crawlers tal-AI huma permessi jew imblukkati, ittestja mogħdijiet kontra r-regoli, u ċċekkja kif is-server iwieġeb lil kull crawler."

msgctxt "page.skip"
msgid "Skip to content"
msgstr "Aqbeż għall-kontenut"

msgctxt "page.h1"
msgid "Check and understand your robots.txt before traffic drops"
msgstr "Iċċekkja u ifhem ir-robots.txt tiegħek qabel ma jonqos it-traffiku"

msgctxt "page.themeLabel"
msgid "Colour theme"
msgstr "Tema tal-kulur"

msgctxt "ui.theme.toLight"
msgid "Switch to the light theme"
msgstr "Aqleb għat-tema ċara"

msgctxt "ui.theme.toDark"
msgid "Switch to the dark theme"
msgstr "Aqleb għat-tema skura"

msgctxt "page.langLabel"
msgid "Language"
msgstr "Lingwa"

msgctxt "page.intro"
msgid "Enter your domain above. You get a verdict for the business, a fix list that links to the exact lines, and a message you can send straight to IT."
msgstr "Daħħal id-dominju tiegħek hawn fuq. Tikseb verdett għan-negozju, lista ta' rranġar li twassal għal-linji eżatti, u messaġġ li tista' tibgħat dritt lill-IT."

msgctxt "page.urlLabel"
msgid "Domain, or any address on the site"
msgstr "Dominju, jew kwalunkwe indirizz fis-sit"

msgctxt "page.analyse"
msgid "Check robots.txt"
msgstr "Iċċekkja robots.txt"

msgctxt "page.urlHint"
msgid "Paste whatever you have: a domain, a page, a link from an email, even the <code>robots.txt</code> address itself. We read <code>/robots.txt</code> from that site and ignore the rest."
msgstr "Waħħal dak li għandek: dominju, paġna, link minn email, anke l-indirizz tar-<code>robots.txt</code> innifsu. Naqraw <code>/robots.txt</code> minn dak is-sit u ninjoraw il-bqija."

msgctxt "page.pasteSummary"
msgid "Paste a robots.txt instead"
msgstr "Jew waħħal robots.txt"

msgctxt "page.pasteLabel"
msgid "robots.txt contents"
msgstr "Kontenut tar-robots.txt"

msgctxt "page.analysePasted"
msgid "Analyse pasted text"
msgstr "Analizza t-test imwaħħal"

msgctxt "page.loadExample"
msgid "Load the kitchen-sink example"
msgstr "Tella' l-eżempju sħiħ"

msgctxt "page.aiStatus"
msgid "AI scraping status"
msgstr "Status tal-iscraping tal-IA"

msgctxt "page.agents"
msgid "Crawler access"
msgstr "Aċċess tal-crawlers"

msgctxt "page.agentsIntro"
msgid "Resolved per crawler with RFC 9309 matching: the most specific group wins, then the longest rule, and ties go to <code>Allow</code>."
msgstr "Solvut għal kull crawler bl-RFC 9309: jirbaħ l-iktar grupp speċifiku, imbagħad l-itwal regola, u f'każ ta' ugwaljanza <code>Allow</code>."

msgctxt "page.tester"
msgid "Test a path"
msgstr "Ittestja mogħdija"

msgctxt "page.access"
msgid "Real access by crawler"
msgstr "Aċċess reali skont il-crawler"

msgctxt "page.accessIntro"
msgid "Request the file again through the proxy, identifying as each crawler in turn. A different status or body means the server treats that crawler differently (bot blocking, WAF rules, cloaking)."
msgstr "Jitlob il-fajl mill-ġdid permezz tal-proxy u jidentifika ruħu bħala kull crawler, wieħed wara l-ieħor. Status jew kontenut differenti jfisser li s-server jittratta dak il-crawler b’mod differenti (imblukkar ta’ bots, regoli WAF, cloaking)."

msgctxt "page.issues"
msgid "Issues"
msgstr "Problemi"

msgctxt "page.security"
msgid "Security notes"
msgstr "Noti ta' sigurtà"

msgctxt "page.securityIntro"
msgid "Disallow rules that name sensitive files and folders, which attackers look for first. This checks what the file reveals, not whether the paths exist or are protected."
msgstr "Regoli Disallow li jsemmu fajls u folders sensittivi, li l-attakkanti jfittxu l-ewwel. Dan jiċċekkja x’jikxef il-fajl, mhux jekk il-mogħdijiet jeżistux jew humiex protetti."

msgctxt "page.recon"
msgid "Reconnaissance"
msgstr "Rikonoxximent"

msgctxt "page.reconIntro"
msgid "What a stranger learns about this site from the file alone: the platform it runs on, cloud buckets, other hostnames, API entry points, data feeds, file types, and notes left in comments. Nothing here is fetched or probed; it is read straight from the text."
msgstr "X'jitgħallem barrani dwar dan is-sit mill-fajl biss: il-pjattaforma, buckets fil-cloud, hostnames oħra, punti ta' dħul tal-API, feeds tad-data, tipi ta' fajls, u noti mħollija fil-kummenti. Xejn hawn ma jitniżżel jew jiġi ttestjat; jinqara direttament mit-test."

msgctxt "page.sitemaps"
msgid "Sitemaps"
msgstr "Sitemaps"

msgctxt "page.raw"
msgid "File contents"
msgstr "Kontenut tal-fajl"

msgctxt "page.footerRfc"
msgid "Rule matching follows <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> and Google's published crawler behaviour."
msgstr "It-tqabbil tar-regoli jsegwi l-<a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> u l-imġiba tal-crawlers ippubblikata minn Google."

msgctxt "page.footerBy"
msgid "A free tool by <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."
msgstr "Għodda b'xejn minn <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."

msgctxt "page.noscript"
msgid "This tool runs entirely in your browser and needs JavaScript."
msgstr "Din l-għodda taħdem kompletament fil-browser tiegħek u teħtieġ JavaScript."

msgctxt "enum.level.error"
msgid "Error"
msgstr "Żball"

msgctxt "enum.level.warning"
msgid "Warning"
msgstr "Twissija"

msgctxt "enum.level.info"
