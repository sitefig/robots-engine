msgstr ""
"Project-Id-Version: sus.bot\n"
"Language-Team: lietuvių\n"
"Language: lt\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=4; plural=(n % 10 == 1 && (n % 100 < 11 || n % 100 > 19) ? 0 : n % 10 >= 2 && n % 10 <= 9 && (n % 100 < 11 || n % 100 > 19) ? 1 : 3);\n"

msgctxt "page.title"
msgid "sus.bot | robots.txt checker"
msgstr "sus.bot | robots.txt tikrintuvas"

msgctxt "page.description"
msgid "Free robots.txt checker. Fetch any site's robots.txt, see which search engines and AI crawlers are allowed or blocked, test paths against the rules, and check how the server responds to each crawler."
msgstr "Nemokamas robots.txt tikrintuvas. Atsisiųskite bet kurios svetainės robots.txt, pamatykite, kurios paieškos sistemos ir DI robotai leidžiami ar blokuojami, patikrinkite kelius pagal taisykles ir sužinokite, kaip serveris atsako kiekvienam robotui."

msgctxt "page.skip"
msgid "Skip to content"
msgstr "Pereiti prie turinio"

msgctxt "page.h1"
msgid "Check and understand your robots.txt before traffic drops"
msgstr "Patikrinkite ir supraskite savo robots.txt, kol srautas dar nesumažėjo"

msgctxt "page.themeLabel"
msgid "Colour theme"
msgstr "Spalvų tema"

msgctxt "ui.theme.toLight"
msgid "Switch to the light theme"
msgstr "Perjungti į šviesią temą"

msgctxt "ui.theme.toDark"
msgid "Switch to the dark theme"
msgstr "Perjungti į tamsią temą"

msgctxt "page.langLabel"
msgid "Language"
msgstr "Kalba"

msgctxt "page.intro"
msgid "Enter your domain above. You get a verdict for the business, a fix list that links to the exact lines, and a message you can send straight to IT."
msgstr "Įveskite savo domeną viršuje. Gausite verdiktą verslui, pataisymų sąrašą su nuorodomis į tikslias eilutes ir pranešimą, kurį galite išsiųsti tiesiai IT."

msgctxt "page.urlLabel"
msgid "Domain, or any address on the site"
msgstr "Domenas arba bet kuris svetainės adresas"

msgctxt "page.analyse"
msgid "Check robots.txt"
msgstr "Patikrinti robots.txt"

msgctxt "page.urlHint"
msgid "Paste whatever you have: a domain, a page, a link from an email, even the <code>robots.txt</code> address itself. We read <code>/robots.txt</code> from that site and ignore the rest."
msgstr "Įklijuokite, ką turite: domeną, puslapį, nuorodą iš el. laiško ar net patį <code>robots.txt</code> adresą. Iš tos svetainės perskaitome <code>/robots.txt</code>, o visa kita ignoruojame."

msgctxt "page.pasteSummary"
msgid "Paste a robots.txt instead"
msgstr "Arba įklijuokite robots.txt"

msgctxt "page.pasteLabel"
msgid "robots.txt contents"
msgstr "robots.txt turinys"

msgctxt "page.analysePasted"
msgid "Analyse pasted text"
msgstr "Analizuoti įklijuotą tekstą"

msgctxt "page.loadExample"
msgid "Load the kitchen-sink example"
msgstr "Įkelti pavyzdį su viskuo"

msgctxt "page.aiStatus"
msgid "AI scraping status"
msgstr "DI duomenų rinkimo būsena"

msgctxt "page.agents"
msgid "Crawler access"
msgstr "Robotų prieiga"

msgctxt "page.agentsIntro"
msgid "Resolved per crawler with RFC 9309 matching: the most specific group wins, then the longest rule, and ties go to <code>Allow</code>."
msgstr "Nustatoma kiekvienam robotui pagal RFC 9309: laimi konkrečiausia grupė, tada ilgiausia taisyklė, o lygiųjų atveju – <code>Allow</code>."

msgctxt "page.tester"
msgid "Test a path"
msgstr "Patikrinti kelią"

msgctxt "page.access"
msgid "Real access by crawler"
msgstr "Tikroji prieiga pagal robotą"

msgctxt "page.accessIntro"
msgid "Request the file again through the proxy, identifying as each crawler in turn. A different status or body means the server treats that crawler differently (bot blocking, WAF rules, cloaking)."
msgstr "Failas dar kartą užklausiamas per tarpinį serverį, paeiliui prisistatant kiekvienu robotu. Kitokia būsena ar turinys reiškia, kad serveris tą robotą traktuoja kitaip (botų blokavimas, WAF taisyklės, cloaking)."

msgctxt "page.issues"
msgid "Issues"
msgstr "Problemos"

msgctxt "page.security"
msgid "Security notes"
msgstr "Saugumo pastabos"

msgctxt "page.securityIntro"
msgid "Disallow rules that name sensitive files and folders, which attackers look for first. This checks what the file reveals, not whether the paths exist or are protected."
msgstr "Disallow taisyklės, įvardijančios jautrius failus ir aplankus, kurių užpuolikai ieško pirmiausia. Tikrinama, ką failas atskleidžia, o ne ar keliai egzistuoja arba yra apsaugoti."

msgctxt "page.recon"
msgid "Reconnaissance"
msgstr "Žvalgyba"

msgctxt "page.reconIntro"
msgid "What a stranger learns about this site from the file alone: the platform it runs on, cloud buckets, other hostnames, API entry points, data feeds, file types, and notes left in comments. Nothing here is fetched or probed; it is read straight from the text."
msgstr "Ką svetimas sužino apie šią svetainę vien iš failo: platformą, debesų saugyklas, kitus serverių vardus, API įėjimo taškus, duomenų srautus, failų tipus ir komentaruose paliktas pastabas. Nieko čia neatsisiunčiama ir netikrinama; viskas skaitoma tiesiai iš teksto."

msgctxt "page.sitemaps"
msgid "Sitemaps"
msgstr "Svetainės žemėlapiai"

msgctxt "page.raw"
msgid "File contents"
msgstr "Failo turinys"

msgctxt "page.footerRfc"
msgid "Rule matching follows <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> and Google's published crawler behaviour."
msgstr "Taisyklių atitikimas vadovaujasi <a href=\"https://www.rfc-editor.org/rfc/rfc9309\" rel=\"noopener\">RFC 9309</a> ir „Google“ paskelbtu robotų elgesiu."

msgctxt "page.footerBy"
msgid "A free tool by <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a>."
msgstr "Nemokamas <a href=\"https://sitefig.eu\" rel=\"noopener\">Sitefig</a> įrankis."

msgctxt "page.noscript"
msgid "This tool runs entirely in your browser and needs JavaScript."
msgstr "Šis įrankis veikia tik jūsų naršyklėje ir jam reikia JavaScript."

