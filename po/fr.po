msgctxt "page.cli.title"
msgid "Command line and GitHub Action"
msgstr "Ligne de commande et GitHub Action"

msgctxt "page.cli.body"
msgid "Run the same checks in your terminal or in CI. The build can fail when a rule changes."
msgstr "Lancez les mêmes contrôles dans votre terminal ou en CI. Le build peut échouer quand une règle change."

msgctxt "page.cli.link"
