msgstr "media"

msgctxt "enum.confidence.low"
msgid "low"
msgstr "bassa"

msgctxt "enum.risk.high"
msgid "high"
msgstr "alto"

msgctxt "enum.risk.medium"
msgid "medium"
msgstr "medio"

msgctxt "enum.risk.low"
msgid "low"
msgstr "basso"

msgctxt "enum.role.search"
msgid "search"
msgstr "ricerca"

msgctxt "enum.role.filter"
msgid "filter"
msgstr "filtro"

msgctxt "enum.role.tracking"
msgid "tracking"
