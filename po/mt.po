msgstr "Imblukkat"

msgctxt "enum.kind.syntax"
msgid "Syntax"
msgstr "Sintassi"

msgctxt "enum.kind.seo-trap"
msgid "SEO trap"
msgstr "Nassa tal-SEO"

msgctxt "enum.kind.sitemap"
msgid "Sitemap"
msgstr "Sitemap"

msgctxt "enum.kind.fetch"
msgid "Fetch"
msgstr "Tniżżil"

msgctxt "enum.kind.lint"
msgid "Lint"
msgstr "Lint"

msgctxt "enum.severity.high"
msgid "high"
msgstr "għolja"

msgctxt "enum.severity.medium"
msgid "medium"
msgstr "medja"

msgctxt "enum.severity.low"
msgid "low"
msgstr "baxxa"

msgctxt "enum.confidence.high"
msgid "high"
msgstr "għolja"

msgctxt "enum.confidence.medium"
