msgctxt "page.testerIntro"
msgid "Check any path or URL against any crawler."
msgstr "Testez n'importe quel chemin ou URL avec n'importe quel robot."

msgctxt "page.regression.title"
msgid "Find out when a release changes your robots.txt"
msgstr "Sachez quand une mise en production modifie votre robots.txt"

msgctxt "page.regression.body"
msgid "Monitoring runs these checks again and tells you when a sensitive path or a syntax error appears in your file."
msgstr "La surveillance relance ces contrôles et vous prévient quand un chemin sensible ou une erreur de syntaxe apparaît dans votre fichier."

msgctxt "page.regression.cta"
msgid "Set up monitoring"
msgstr "Configurer la surveillance"

msgctxt "page.pricing.title"
msgid "Pricing"
msgstr "Tarifs"

msgctxt "page.pricing.body"
