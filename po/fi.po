msgctxt "md.sitemaps.none"
msgid "No Sitemap line. Optional, but it helps crawlers discover URLs."
msgstr "Sitemap-riviä ei ole. Se on valinnainen, mutta auttaa indeksoijia löytämään URL-osoitteet."

msgctxt "md.actions.redirectChain"
msgid "Fix the redirect chain on /robots.txt: crawlers give up after five hops and treat the file as missing."
msgstr "Korjaa polun /robots.txt uudelleenohjausketju: indeksoijat luovuttavat viiden hypyn jälkeen ja käsittelevät tiedostoa puuttuvana."

msgctxt "md.actions.serverError"
msgid "Fix the server error on /robots.txt. Google treats 5xx as \"disallow everything\" for up to 30 days."
msgstr "Korjaa polun /robots.txt palvelinvirhe. Google tulkitsee 5xx-vastauksen jopa 30 päivän ajan niin, että kaikki on kielletty."

msgctxt "md.actions.syntaxErrors"
msgid "Fix {errors} that make lines ignored{where}."
msgstr "Korjaa virheet, joiden takia rivejä ohitetaan: {errors}{where}."

msgctxt "md.actions.trailingSlash"
msgid "Decide whether {rules} should end in \"/\" (directory) or \"$\" (exact URL); as written they also match longer paths{where}."
msgstr "Päätä, tuleeko sääntöjen loppuun ”/” (hakemisto) vai ”$” (tarkka URL): {rules}{where}. Nykyisessä muodossaan ne täsmäävät myös pidempiin polkuihin."

msgctxt "md.actions.selfBlock"
msgid "Remove the rule that matches /robots.txt itself{where}."
msgstr "Poista sääntö, joka täsmää itse polkuun /robots.txt{where}."

msgctxt "md.actions.deadRules"
msgid "Remove {rules} that never take effect{where}."
msgstr "Poista säännöt, jotka eivät vaikuta koskaan: {rules}{where}."

msgctxt "md.actions.absoluteUrl"
msgid "Rewrite {rules} as paths{where}."
msgstr "Kirjoita absoluuttiset URL-osoitteet poluiksi: {rules}{where}."

msgctxt "md.actions.noSlash"
msgid "Add the leading \"/\" to {paths} that can never match{where}."
msgstr "Lisää alkuun ”/” polkuihin, jotka eivät muuten voi täsmätä koskaan: {paths}{where}."

msgctxt "md.actions.protocol"
msgid "List sitemaps with https URLs{where}."
msgstr "Merkitse sivustokartat https-osoitteilla{where}."

msgctxt "md.actions.crossDomain"
msgid "Verify cross-domain sitemap ownership in Search Console, or move {sitemaps} onto this domain{where}."
msgstr "Vahvista toisessa verkkotunnuksessa olevan sivustokartan omistajuus Search Consolessa tai siirrä {sitemaps} tähän verkkotunnukseen{where}."

msgctxt "md.actions.relativeSitemap"
msgid "Make {lines} absolute URLs{where}."
msgstr "Vaihda tilalle absoluuttinen URL: {lines}{where}."

msgctxt "md.actions.addSitemap"
msgid "Add a Sitemap line pointing at the XML sitemap."
msgstr "Lisää Sitemap-rivi, joka osoittaa XML-sivustokarttaan."

msgctxt "md.actions.noindex"
msgid "Move noindex out of robots.txt into a robots meta tag or X-Robots-Tag header; no search engine honours it here."
msgstr "Siirrä noindex robots.txt-tiedostosta robots-metatagiin tai X-Robots-Tag-otsakkeeseen. Yksikään hakukone ei noudata sitä täällä."

msgctxt "md.actions.crawlDelay"
msgid "Treat Crawl-delay as Bing-only; use Search Console crawl settings for Google."
msgstr "Pidä Crawl-delay-direktiiviä vain Bingiä koskevana. Käytä Googlelle Search Consolen indeksointiasetuksia."

msgctxt "md.actions.starBlocked"
msgid "Confirm that blocking the whole site for every crawler without its own group is intended."
msgstr "Varmista, että koko sivuston estäminen kaikilta indeksoijilta, joilla ei ole omaa ryhmää, on tarkoituksellista."

msgctxt "md.actions.security"
msgid "{label}: {advice} Paths: {paths}{more}."
msgstr "{label}: {advice} Polut: {paths}{more}."

msgctxt "md.actions.more"
msgid " and {n} more"
msgstr " ja {n} muuta"

msgctxt "md.actions.aiUneven"
msgid "Decide on one AI-training policy. Still allowed or only partly restricted: {list}."
msgstr "Päätä yksi yhtenäinen linja tekoälyn koulutukselle. Yhä sallittu tai vain osittain rajoitettu: {list}."

msgctxt "md.actions.aiDecide"
msgid "Decide whether AI training crawlers (GPTBot, ClaudeBot, CCBot and others) should be allowed; none is restricted today."
msgstr "Päätä, sallitaanko tekoälyn koulutusindeksoijat (GPTBot, ClaudeBot, CCBot ja muut). Tällä hetkellä yhtäkään ei ole rajoitettu."

msgctxt "md.actions.buckets"
msgid "Check permissions on the cloud buckets named in the file: {list}."
msgstr "Tarkista tiedostossa mainittujen pilvisäilöjen käyttöoikeudet: {list}."

msgctxt "md.actions.envHosts"
msgid "Remove non-production hostnames from the file and put those environments behind authentication: {list}."
msgstr "Poista tuotannon ulkopuoliset isäntänimet tiedostosta ja suojaa kyseiset ympäristöt tunnistautumisella: {list}."

msgctxt "md.actions.personal"
msgid "Strip names, email addresses, IPs and ticket IDs from comments; the file is public."
msgstr "Poista kommenteista nimet, sähköpostiosoitteet, IP-osoitteet ja tikettitunnukset. Tiedosto on julkinen."

msgctxt "md.actions.bom"
msgid "Save the file as UTF-8 without a byte-order mark."
msgstr "Tallenna tiedosto UTF-8-muodossa ilman tavujärjestysmerkkiä."

msgctxt "md.actions.none"
msgid "No action needed. The file is clean."
msgstr "Toimenpiteitä ei tarvita. Tiedosto on kunnossa."

